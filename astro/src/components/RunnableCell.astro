---
// Runnable Python cell — an interactive island that runs code through Pyodide.
interface Props { code: string; lessonId?: string; }
const {code, lessonId} = Astro.props;
---

<div class="cell" data-runnable data-lesson={lessonId ?? ''}>
  <div class="cell__actions">
    <button class="btn btn-primary cell__run" data-run aria-label="Run this Python code">▶ Run</button>
    <span class="cell__lang">python</span>
  </div>
  <pre class="cell__code"><code>{code}</code></pre>
  <div class="cell__output" data-output hidden>
    <div class="cell__lines" data-lines></div>
    <button class="cell__clear" data-clear hidden>Clear</button>
  </div>
</div>

{/* .cell styles live in global.css (unscoped) so rehype-generated cells inside
    markdown lesson bodies — which aren't this component — are styled too. */}
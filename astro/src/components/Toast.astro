---
// XP toast — a floating notification shown when a learner earns XP.
interface Props { xp: number; label?: string }
const { xp, label = `+${xp} XP` } = Astro.props;
---

<div class="toast" role="status" aria-live="polite">
  <span class="toast__icon">⚡</span>
  <span class="toast__text">{label}</span>
</div>

<style>
  .toast {
    display: inline-flex; align-items: center; gap: .4rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--accent-contrast); padding: .35rem .8rem;
    border-radius: 999px; font-weight: 700; font-size: .85rem;
    box-shadow: 0 4px 14px rgba(91,33,182,.35);
    animation: toast-in .35s ease both;
  }
  .toast__icon { font-size: 1rem; }
  @keyframes toast-in { from { opacity:0; transform:translateY(8px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
</style>
---
import Base from '../../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="تعلّم — PyDA" lang="ar" dir="rtl">
  <div class="container head">
    <h1>مسارك التعليمي</h1>
    <p>قسمان. مساران لكل قسم. وصديق إلى جانبك.</p>
  </div>
  <div class="container cards">
    <a class="card c" href={`${base}ar/learn/python-101/normal/week-1`}>
      <span class="ci">🐍</span>
      <h2>بايثون ١٠١</h2>
      <p>الأسابيع ١–٥: المتغيرات، التحكم، الدوال، ثم نموذج لغة صغير.</p>
      <span class="btn btn-primary">ابدأ من هنا</span>
    </a>
    <div class="card c">
      <span class="ci">📊</span>
      <h2>باندا وتحليل البيانات</h2>
      <p>الأسابيع ٦–١٠: دفتر ملاحظات حقيقي بأسلوب محلل البيانات.</p>
      <span class="btn btn-ghost" style="pointer-events:none">قريبًا</span>
    </div>
  </div>
</Base>

<style>
  .head { margin: 2rem 0 1rem; }
  .cards { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin:1.5rem 0 3rem; }
  .c { padding:1.5rem; text-decoration:none; color:var(--ink); display:flex; flex-direction:column; gap:.4rem; box-shadow:var(--shadow-sm); transition:transform .2s ease; }
  .c:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); }
  .ci { font-size:2rem; }
  @media (max-width:720px){ .cards{grid-template-columns:1fr;} }
</style>

---
// Arabic (RTL) proof-of-concept lesson — demonstrates i18n + RTL layout.
import Base from '../../../../../layouts/Base.astro';
import RunnableCell from '../../../../../components/RunnableCell.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="الأسبوع ١ · المتغيرات — PyDA" lang="ar" dir="rtl">
  <nav class="crumb container">
    <a href={`${base}ar/learn`}>تعلّم</a> <span>/</span>
    <a href={`${base}ar/learn/python-101`}>بايثون ١٠١</a> <span>/</span>
    <span class="crumb__here">الأسبوع ١</span>
  </nav>

  <article class="container">
    <header class="lesson-head">
      <span class="lesson-head__week">بايثون ١٠١ · المسار العادي</span>
      <h1>الأسبوع ١ — المتغيرات والأنواع والإدخال/الإخراج</h1>
    </header>

    <div class="note">
      أهلاً بك 🎮 اليوم سنكتب تعليمات يقبلها الحاسوب.
      اضغط زر <strong>التشغيل</strong> تحت كل مربع لترى الناتج فوراً.
    </div>

    <h2>المتغيرات أسماء للقيَم</h2>
    <p>في الرياضيات «ليكن <code class="ltr">x = 5</code>» يربط اسمًا بقيمة. بايثون تفعل ذلك تمامًا:</p>

    <RunnableCell code={`score = 87\nprint("Your score is", score)`} />

    <div class="note">
      لاحظت؟ خزّنت بايثون الرقم <code class="ltr">87</code> تحت اسم <code class="ltr">score</code>، ثم
      دمجه <code class="ltr">print</code> في جملة. جرّب تغيير الرقم وأعد التشغيل.
    </div>

    <h2>قراءة الإدخال: input()</h2>
    <RunnableCell code={`name = input("What's your name? ")\nprint("Nice to meet you,", name)`} />

    <div class="note note--warn">
      ⚠️ <code class="ltr">input()</code> يفتح نافذة في المتصفح لكتابة الإجابة.
    </div>
  </article>
</Base>

<style>
  .ltr { direction: ltr; unicode-bidi: isolate; display: inline-block; }
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size:.88rem; align-items:center; }
  .crumb a { color: var(--ink-soft); text-decoration:none; }
  .crumb__here { font-weight:700; color:var(--ink); }
  .lesson-head { margin: 1.5rem 0 1rem; }
  .lesson-head__week { color: var(--accent); font-weight:800; letter-spacing:.02em; text-transform:uppercase; font-size:.8rem; }
  .lesson-head h1 { font-size: clamp(1.8rem,4vw,2.6rem); }
  code { background: var(--surface-2); padding:.1rem .35rem; border-radius:6px; font-size:.9em; }
</style>

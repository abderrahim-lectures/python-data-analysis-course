---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base
  title="Real-World Projects — PyDA"
  description="Optional, ungraded projects that take you from the in-browser playground to real Python: agents, MCP servers, CLIs, and more."
  lang="en"
  dir="ltr"
>
  <section class="hero">
    <div class="container head">
      <div class="head__eyebrow"><Icon name="code" size={16} /> Beyond the course</div>
      <h1>Real-World Projects</h1>
      <p>Optional, ungraded builds that graduate you from the browser playground to real Python on your machine.</p>
    </div>
  </section>

  <section class="container">
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`${base}projects/${p.slug.replace(/^\/?projects\//, '')}`}>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding: 2.5rem 0 1.5rem; }
  .head__eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; display: inline-flex; align-items: center; gap: .3rem; }
  .head h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: .4rem 0 .2rem; }
  .head p { color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.1rem; margin: 1.5rem 0 3rem; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.3rem; text-decoration: none; color: var(--ink); box-shadow: var(--shadow-sm); transition: all var(--transition-smooth); }
  .card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .card h2 { font-size: 1.05rem; margin: 0 0 .5rem; }
  .card p { color: var(--ink-soft); font-size: .88rem; margin: 0; line-height: 1.5; }
</style>

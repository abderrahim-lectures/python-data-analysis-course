---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatsProfile from '../components/StatsProfile.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="My Stats — PyDA" lang="en" dir="ltr">
  <section class="stats-hero">
    <div class="stats-hero__bg" aria-hidden="true"></div>
    <div class="stats-hero__inner">
      <div class="stats-hero__player">
        <div class="stats-hero__avatar">🧑‍💻</div>
        <div>
          <span class="stats-hero__eyebrow"><Icon name="trophy" size={14} /> Season report</span>
          <h1>Your Ranked Stats</h1>
          <p>Track your climb — XP, streaks, badges, and rank.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- Quick stats bar -->
    <div class="quick-bar" id="quick-bar">
      <div class="quick-bar__item">
        <span class="quick-bar__icon">⚡</span>
        <span class="quick-bar__val" id="qb-xp">0</span>
        <span class="quick-bar__label">XP</span>
      </div>
      <div class="quick-bar__item">
        <span class="quick-bar__icon">⬆️</span>
        <span class="quick-bar__val" id="qb-level">1</span>
        <span class="quick-bar__label">Level</span>
      </div>
      <div class="quick-bar__item quick-bar__item--streak">
        <span class="quick-bar__icon">🔥</span>
        <span class="quick-bar__val" id="qb-streak">0</span>
        <span class="quick-bar__label">Streak</span>
      </div>
      <div class="quick-bar__item">
        <span class="quick-bar__icon">🏅</span>
        <span class="quick-bar__val" id="qb-badges">0</span>
        <span class="quick-bar__label">Badges</span>
      </div>
    </div>

    <StatsProfile mode="client" />

    <div class="stats-reset">
      <a class="btn btn-ghost" href={`${base}progress`}><Icon name="trail" size={15} /> ← Back to the trail</a>
    </div>
  </div>
</Base>

<style>
  .stats-hero__bg { position: absolute; inset: 0; z-index: 0; background: radial-gradient(60% 80% at 50% 40%, rgba(124,58,237,.15), rgba(255,150,0,.08), transparent 70%); }
  .stats-hero { padding: 3rem 0 2rem; position: relative; overflow: hidden; }
  .stats-hero__inner { width:100%; height:100%; display:flex; align-items:flex-end; padding:0 1.4rem .8rem; position: relative; z-index: 1; }
  .stats-hero__player { display: flex; align-items: center; gap: .75rem; }
  .stats-hero__avatar { font-size: 2.5rem; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: var(--surface); border-radius: var(--radius-lg); border: 2px solid var(--line); box-shadow: var(--shadow-md); }
  .stats-hero__eyebrow { color:var(--accent); font-weight:700; text-transform:uppercase; letter-spacing:.06em; font-size:.75rem; display: inline-flex; align-items: center; gap: .3rem; }
  .stats-hero h1 { color:#fff; margin:.1rem 0; font-size:2rem; text-shadow:0 2px 12px rgba(0,0,0,.5); font-family: var(--font-display); }
  .stats-hero p { color:#e6e0ff; margin:0; font-size:.95rem; text-shadow:0 1px 6px rgba(0,0,0,.5); }

  /* Quick stats bar */
  .quick-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin-bottom: 1.5rem; }
  .quick-bar__item {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: .85rem; text-align: center; box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; align-items: center; gap: .15rem;
    transition: all var(--transition-smooth);
  }
  .quick-bar__item:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .quick-bar__item--streak { border-color: rgba(255,150,0,.3); box-shadow: var(--shadow-streak-glow); }
  .quick-bar__icon { font-size: 1.1rem; }
  .quick-bar__val { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; color: var(--ink-hi); }
  .quick-bar__label { font-size: .7rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; }

  .stats-reset { margin: 1.6rem 0 2rem; }
  @media (max-width:560px){
    .stats-hero__inner{ align-items:center; flex-direction: column; text-align: center; }
    .stats-hero h1 { font-size: 1.5rem; }
    .quick-bar { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script is:inline>
  // Populate quick stats bar from localStorage
  const s = JSON.parse(localStorage.getItem('pda:state') || '{}');
  const xp = s.xp || 0;
  const level = Math.floor(xp / 100) + 1;
  const streak = s.streak || 0;
  const badges = s.badges || [];
  const qbx = document.getElementById('qb-xp');
  const qbl = document.getElementById('qb-level');
  const qbs = document.getElementById('qb-streak');
  const qbb = document.getElementById('qb-badges');
  if (qbx) qbx.textContent = String(xp);
  if (qbl) qbl.textContent = String(level);
  if (qbs) qbs.textContent = String(streak);
  if (qbb) qbb.textContent = String(badges.length);
</script>
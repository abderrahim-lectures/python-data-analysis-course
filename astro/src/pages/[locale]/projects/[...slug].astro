---
import {getCollection, type CollectionEntry} from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const LOCALES = ['ar', 'es', 'fr'];
  const projects = await getCollection('projects');
  return projects
    .filter((p) => LOCALES.includes(p.slug.split('/')[0]))
    .map((entry) => {
      const locale = entry.slug.split('/')[0];
      const slug = entry.slug.slice(locale.length + 1);
      return {params: {locale, slug}, props: {entry, locale}};
    });
}

interface Props { entry: CollectionEntry<'projects'>; locale: string }
const {entry, locale} = Astro.props;
const {title, description} = entry.data;
const {Content} = await entry.render();
const base = import.meta.env.BASE_URL;
const dir = locale === 'ar' ? 'rtl' : 'ltr';
---

<Base title={`${title} — PyDA`} description={description} lang={locale} dir={dir}>
  <nav class="crumb container">
    <a href={`${base}${locale}/projects`}>Projects</a> <span>/</span> <span class="crumb__here">{title}</span>
  </nav>

  <article class="container lesson-content">
    <Content />
  </article>
</Base>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .lesson-content { padding-bottom: 3rem; }
  .lesson-content :global(h1) { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 1.2rem 0 .5rem; }
  .lesson-content :global(h2) { margin-top: 2.2rem; }
</style>

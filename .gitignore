# Dependencies
/node_modules

# Astro build output & cache
/dist
/.astro

# Vitest coverage report
/coverage

# Generated files
.cache-loader

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# JupyterLite build output
jupyterlite-config/_output
jupyterlite-config/.jupyterlite.doit.db

# Playwright
/test-results
/playwright-report

# Generated sample database (examples/mcp-sqlite-server/seed.py)
examples/mcp-sqlite-server/library.db

# Wordle Clone example's local persistent stats file
examples/wordle-clone/stats.json

# Python bytecode cache (generated by running any examples/ script locally)
__pycache__/
*.pyc

# Virtualenvs created inside examples/ (each example has its own .gitignore
# too; these are belt-and-suspenders for the big ones that share subtrees)
examples/**/.venv/
examples/**/venv/
examples/**/.venv_*/
examples/**/node_modules/

# Vendored at build time by scripts/vendor-pyodide.mjs; keep the seaborn wheel (missing from the Pyodide lock)
public/pyodide/*
!public/pyodide/seaborn-0.13.2-py3-none-any.whl

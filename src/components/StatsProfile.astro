---
// Game-style "after-action report" — LoL/Dota-inspired improvement stats,
// computed live from the student's own tracked data. Renders on the server
// with default/empty values, then the client script fills real metrics.
interface Props {
  mode?: 'ssr' | 'client';
}
const {mode = 'ssr'} = Astro.props;
---

<section class="profile" data-profile>
  <!-- Rank + level header -->
  <div class="profile__header">
    <div class="profile__rank">
      <span class="profile__rankbadge" data-rank>🌱 Bronze</span>
      <span class="profile__level" data-level>Tier 1</span>
    </div>
    <div class="profile__xpbar" role="progressbar" aria-label="XP progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div class="profile__xpfill" data-xpfill style="width:0%"></div>
      <span class="profile__xptext" data-xptext>0 XP</span>
    </div>
  </div>

  <!-- Big number row -->
  <div class="profile__kpis">
    <div class="kpi">
      <span class="kpi__label">Win rate</span>
      <span class="kpi__value" data-winrate>0%</span>
      <span class="kpi__sub" data-winrate-sub>quiz accuracy</span>
    </div>
    <div class="kpi">
      <span class="kpi__label">K/D/A</span>
      <span class="kpi__value" data-kda>0/0/0</span>
      <span class="kpi__sub" data-kda-label>Rookie</span>
    </div>
    <div class="kpi">
      <span class="kpi__label">Streak</span>
      <span class="kpi__value" data-streak>0🔥</span>
      <span class="kpi__sub" data-beststreak>best 0</span>
    </div>
    <div class="kpi">
      <span class="kpi__label">Farm</span>
      <span class="kpi__value" data-farm>0/10</span>
      <span class="kpi__sub">lessons cleared</span>
    </div>
  </div>

  <!-- Lane mastery -->
  <h2 class="profile__h2">🏟️ Lane mastery</h2>
  <div class="lanes" data-lanes>
    <div class="lane">
      <span class="lane__name">Python 101</span>
      <div class="lane__bar"><div class="lane__fill" style="width:0%"></div></div>
      <span class="lane__pct" data-lane>0/5</span>
    </div>
    <div class="lane">
      <span class="lane__name">Pandas &amp; Data</span>
      <div class="lane__bar"><div class="lane__fill" style="width:0%"></div></div>
      <span class="lane__pct" data-lane>0/5</span>
    </div>
  </div>

  <!-- Effectiveness diagnostics, inspired by published learning-science research -->
  <h2 class="profile__h2">📈 Improvement report</h2>
  <p class="profile__lede">
    How you're climbing vs. a proven learning-science benchmark
    (<a href="https://doi.org/10.58477/dj.v4i1.348" target="_blank" rel="noreferrer">Prayoga et&nbsp;al., 2026</a>).
  </p>
  <div class="diag" data-diag>
    <div class="diag__row">
      <span class="diag__name">Progress (improvement)</span>
      <div class="diag__bar"><div class="diag__fill" style="width:0%"></div></div>
      <span class="diag__val" data-diag>0%</span>
    </div>
    <div class="diag__row">
      <span class="diag__name">Gain vs study (N-Gain)</span>
      <div class="diag__bar"><div class="diag__fill" style="width:0%"></div></div>
      <span class="diag__val" data-diag>0.00</span>
    </div>
    <div class="diag__row">
      <span class="diag__name">Acceptance (motivation)</span>
      <div class="diag__bar"><div class="diag__fill" style="width:0%"></div></div>
      <span class="diag__val" data-diag>0%</span>
    </div>
    <div class="diag__row">
      <span class="diag__name">Usefulness (accuracy)</span>
      <div class="diag__bar"><div class="diag__fill" style="width:0%"></div></div>
      <span class="diag__val" data-diag>0%</span>
    </div>
    <div class="diag__row">
      <span class="diag__name">Learning experience</span>
      <div class="diag__bar"><div class="diag__fill" style="width:0%"></div></div>
      <span class="diag__val" data-diag>0%</span>
    </div>
  </div>

  <p class="profile__footnote">
    In the study, students improved from 41.5% &rarr; 76.9% after the course (N-Gain 0.61).
    Your numbers above are <strong>your own</strong>, computed from everything you've done here.
  </p>
</section>

<script>
  import {computeGameStats} from '../lib/gamestats.ts';

  function fmt(pct: number) {
    const p = Math.max(0, Math.min(100, pct));
    return `${Math.round(p)}%`;
  }
  // small ease-in fill animation
  function fill(el: HTMLElement, target: number) {
    el.style.width = '0%';
    requestAnimationFrame(() => {
      el.style.transition = 'width 1s cubic-bezier(.22,.61,.36,1)';
      el.style.width = fmt(target);
    });
  }

  function render() {
    const s = computeGameStats();
    const el = document.querySelector('[data-profile]');
    if (!el) return;

    el.querySelector('[data-rank]')!.textContent = RANKS[s.rank];
    el.querySelector('[data-level]')!.textContent = `Tier ${s.level}`;
    el.querySelector('[data-xpfill]')!.setAttribute('style', `width:${fmt((s.xp % 100) / 100 * 100)}%`);
    el.querySelector('[data-xptext]')!.textContent = `${s.xp} XP · ${s.xpToNext} to next`;
    el.querySelector('[data-winrate]')!.textContent = fmt(s.quiz.winRate);
    el.querySelector('[data-winrate-sub]')!.textContent = `${s.quiz.correct}/${s.quiz.total} correct`;
    el.querySelector('[data-kda]')!.textContent = `${s.kda.kills}/${s.kda.deaths}/${s.kda.assists}`;
    el.querySelector('[data-kda-label]')!.textContent = s.kda.label + ` · ${s.kda.ratio}`;
    el.querySelector('[data-streak]')!.textContent = `${s.streak}🔥`;
    el.querySelector('[data-beststreak]')!.textContent = `best ${s.bestStreak}`;
    el.querySelector('[data-farm]')!.textContent = `${s.lessonsDone}/${s.lessonsTotal}`;
    el.querySelector('.lanes')!.querySelectorAll('.lane').forEach((lane, i) => {
      const L = s.lanes[i];
      lane.querySelector('.lane__fill')!.setAttribute('style', `width:${L.pct}%`);
      lane.querySelector('.lane__pct')!.textContent = `${L.done}/${L.total}`;
    });
    const diag = s.diagnostics;
    const diagEls = el.querySelectorAll('[data-diag]');
    if (diagEls.length >= 5) {
      diagEls[0]!.textContent = fmt(diag.improvementPct);
      diagEls[1]!.textContent = diag.nGainEquivalent.toFixed(2);
      diagEls[2]!.textContent = fmt(diag.acceptancePct);
      diagEls[3]!.textContent = fmt(diag.usefulnessPct);
      diagEls[4]!.textContent = fmt(diag.learningExperiencePct);
    }
  }

  const RANKS: Record<string, string> = {
    Bronze: '🌱 Bronze', Silver: '⚙️ Silver', Gold: '🥇 Gold',
    Platinum: '💠 Platinum', Diamond: '💎 Diamond', Master: '🔥 Master', Grandmaster: '👑 Grandmaster',
  };
  render();
</script>

<style>
  .profile { display: flex; flex-direction: column; gap: 1.25rem; }
  .profile__header { display: flex; flex-direction: column; gap: .6rem; }
  .profile__rank { display: flex; gap: .6rem; align-items: center; }
  .profile__rankbadge { background: var(--accent); color: var(--accent-contrast); font-weight:700; font-family:var(--font-display); padding:.3rem 1rem; border-radius:var(--radius-sm); }
  .profile__level { color: var(--ink-soft); font-weight:700; }
  .profile__xpbar { height: 14px; background: var(--surface-3); border:1px solid var(--line); border-radius:var(--radius-sm); overflow:hidden; position:relative; }
  .profile__xpfill { height:100%; border-radius:var(--radius-sm); background: linear-gradient(90deg, var(--accent), var(--accent-strong)); }
  .profile__xptext { position:absolute; right:8px; top:50%; transform:translateY(-50%); font-size:.7rem; font-weight:800; color:var(--ink); }
  .profile__kpis { display:grid; grid-template-columns: repeat(4,1fr); gap:.75rem; }
  .kpi { background: var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg); padding:1rem .6rem; text-align:center; box-shadow:var(--shadow-sm); }
  .kpi__label { display:block; color:var(--ink-soft); font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; font-weight:700; }
  .kpi__value { display:block; font-family:var(--font-display); font-size:1.6rem; font-weight:800; color:var(--accent); margin:.1rem 0; }
  .kpi__sub { color:var(--ink-soft); font-size:.75rem; }
  .profile__h2 { font-size:1.25rem; margin:.4rem 0 .4rem; }
  .profile__lede { color: var(--ink-soft); margin-top:-.3rem; font-size:.9rem; }
  .profile__lede a { color: var(--accent); }
  .lanes { display:grid; gap:.7rem; }
  .lane { display:grid; grid-template-columns: 130px 1fr 46px; gap:.6rem; align-items:center; }
  .lane__name { font-weight:700; font-size:.9rem; }
  .lane__bar { height:12px; background:var(--surface-3); border:1px solid var(--line); border-radius:var(--radius-sm); overflow:hidden; }
  .lane__fill { height:100%; border-radius:var(--radius-sm); background: linear-gradient(90deg,var(--accent),var(--accent-strong)); }
  .lane__pct { font-weight:800; color:var(--ink-soft); font-size:.85rem; text-align:right; }
  .diag { display:flex; flex-direction:column; gap:.55rem; }
  .diag__row { display:grid; grid-template-columns: 170px 1fr 52px; gap:.6rem; align-items:center; }
  .diag__name { font-size:.85rem; font-weight:600; }
  .diag__bar { height:10px; background:var(--surface-3); border:1px solid var(--line); border-radius:var(--radius-sm); overflow:hidden; }
  .diag__fill { height:100%; border-radius:var(--radius-sm); background: linear-gradient(90deg,var(--accent),var(--accent-strong)); }
  .diag__val { font-weight:800; font-size:.85rem; text-align:right; color:var(--accent); }
  .profile__footnote { color:var(--ink-soft); font-size:.82rem; border-top:1px dashed var(--line); padding-top:.8rem; margin-top:.3rem; }
  @media (max-width:640px){
    .profile__kpis{grid-template-columns:repeat(2,1fr);}
    .diag__row{grid-template-columns:120px 1fr 46px;}
    .lane{grid-template-columns:110px 1fr 44px;}
  }
  [data-theme='dark'] .profile__rankbadge { background: linear-gradient(135deg,#d4b578,#a4863e); }
</style>

---
// Shared project detail page for every locale: /projects/<slug> (en) and
// /<locale>/<projects-word>/<slug> (ar/es/fr). Each locale's [...id].astro
// page is a thin wrapper passing its entry + locale here, so the date/UX
// markup lives in exactly one place.
//
// Gamification: the client script below turns every `## Step N: ...` heading
// into a clearable "step" (recordProjectStep, +15 XP) and the article into a
// mark-done flow (completeProject, +100 XP + quests). This is the single home
// for that wiring -- content files just write `## Step N:` headings.
import {render, type CollectionEntry} from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectArt from '../ProjectArt.astro';
import {m} from '../../paraglide/messages.js';
import {detectLocale, projectsHref, type Locale} from '../../lib/routeSegments';
import {PROJECT_TAGS, projectDifficulty, DIFFICULTY_COLORS} from '../../lib/projectArt';
import {XP} from '../../lib/gameState';
import '../../styles/project-detail.css';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale?: Locale;
  hasAlternates?: boolean;
}

const {entry} = Astro.props;
const locale: Locale = Astro.props.locale ?? detectLocale(Astro.url.pathname);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
// EN-only content (e.g. `data-visualization`, whose ar/es/fr twins are still
// on the translation backlog) must not advertise alternates that 404. The
// EN wrapper page computes this from the collection and passes it in; the
// localized wrappers themselves are only built when a twin exists, so they
// always have alternates.
const hasAlternates = Astro.props.hasAlternates ?? true;
const base = import.meta.env.BASE_URL;

const {title, description, difficulty, estimatedMinutes, tags} = entry.data;
const {Content} = await render(entry);
const xpAward = XP.PROJECT_COMPLETE;

// Clean slug: strip the locale prefix and any frontmatter-override
// /projects/ prefix so it matches gameState keys and hrefs (e.g. an EN file
// whose `slug: /projects/<name>` frontmatter yields entry.id with that
// prefix). Normalize to the bare name used everywhere, including on the
// [[...id]] getStaticPaths param and localStorage XP keys.
const rawSlug = entry.id.replace(/^(ar|es|fr)\//, '');
const slug = rawSlug.replace(/^\/?projects\//, '');
const diff = difficulty ?? projectDifficulty(slug);
const diffLabel = `difficulty_${diff}` as 'difficulty_beginner' | 'difficulty_intermediate' | 'difficulty_advanced';
const diffText = diff === 'beginner' ? 'var(--success-text)' : diff === 'intermediate' ? 'var(--streak-text)' : 'var(--bad-text)';
const projectTags = (tags?.length ? tags : PROJECT_TAGS[slug] ?? []) as string[];

const enUrl = `projects/${slug}`;
const alternates: Record<Locale, string> = hasAlternates
  ? {en: enUrl, ar: `ar/مشاريع/${slug}`, es: `es/proyectos/${slug}`, fr: `fr/projets/${slug}`}
  : {en: enUrl, ar: enUrl, es: enUrl, fr: enUrl};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: title,
  description,
  learningResourceType: 'Project',
  educationalLevel: difficulty ?? diff ?? 'Beginner',
  isAccessibleForFree: true,
  inLanguage: locale,
  url: String(new URL(projectsHref(locale, base, slug), Astro.site)),
  isPartOf: {
    '@type': 'Course',
    name: 'PyDA Course',
    description: m.course_description(),
  },
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} alternates={alternates} jsonLd={jsonLd}>
  <nav class="crumb container">
    <a href={projectsHref(locale, base)}>{m.projects_eyebrow()}</a> <span>/</span> <span class="crumb__here">{title}</span>
  </nav>

  <div class="container">
    <ProjectArt slug={slug} class="hero-art" />
  </div>

  <article class="container lesson-content project-article" data-project-slug={slug} data-step-label={m.mark_complete()}>
    <header class="project-head">
      <div class="project-head__meta">
        <span class="project-head__diff" style={`color:${diffText}`}>{m[diffLabel]()}</span>
        {estimatedMinutes && <span class="project-head__time">⏱ {estimatedMinutes} min</span>}
        <span class="project-head__xp">⚡ +{xpAward} XP</span>
        <span class="project-head__xp project-head__xp--step">＋{XP.PROJECT_STEP} XP per step</span>
      </div>
      <h1 class="project-title">{title}</h1>
      {projectTags.length > 0 && (
        <div class="project-head__tags">
          {projectTags.map((tag: string) => <span class="project-tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="project-content">
      <Content />
    </div>

    <div class="project-done">
      <button type="button" class="btn btn-soft project-done__btn" data-mark-project-done data-label-done={m.project_completed()}>
        {m.project_mark_done()}
      </button>
      <p class="project-done__hint">{m.project_done_hint()}</p>
    </div>
  </article>
</Base>

<script>
  import {viewProject, completeProject, isProjectComplete, recordProjectStep, isProjectStepDone} from '../../lib/gameState.ts';

  const article = document.querySelector('[data-project-slug]');
  const slug = article?.getAttribute('data-project-slug') ?? '';

  // ── project-view XP ──────────────────────────────────────────────
  if (slug) viewProject(slug);

  // ── step clearing: any "## Step N: …" heading becomes a clear button ──
  // Locale-safe: ar/es/fr projects number their steps as الخطوة / Paso / Étape.
  const STEP_RE = /^(?:Step|Paso|Étape|الخطوة)\s+(\d+)/i;
  const content = article?.querySelector('.project-content');
  const steps: HTMLHeadingElement[] = content
    ? Array.from(content.querySelectorAll('h2')).filter((h) => STEP_RE.test(h.textContent ?? ''))
    : [];

  const clearStep = (h: HTMLHeadingElement): void => {
    const idx = parseInt(h.textContent?.match(STEP_RE)?.[1] ?? '0', 10) - 1;
    if (idx < 0 || !slug) return;
    recordProjectStep(slug.replace(/.*\//, ''), idx);
    h.classList.add('is-step-done');
    h.querySelector<HTMLButtonElement>('.step-clear')?.setAttribute('aria-pressed', 'true');
  };

  steps.forEach((h, i) => {
    h.classList.remove('is-step-done');
    const idx = parseInt(h.textContent?.match(STEP_RE)?.[1] ?? '0', 10) - 1;
    const done = slug ? isProjectStepDone(slug.replace(/.*\//, ''), idx) : false;
    if (done) h.classList.add('is-step-done');
    const stepLabel = article?.getAttribute('data-step-label') ?? 'Mark complete';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'step-clear';
    btn.textContent = stepLabel;
    btn.setAttribute('aria-pressed', String(done));
    btn.setAttribute('aria-label', `${stepLabel} (${i + 1})`);
    btn.addEventListener('click', (e) => { e.stopPropagation(); clearStep(h); });
    h.appendChild(btn);
  });

  // ── mark-done ────────────────────────────────────────────────────
  const btn = document.querySelector('[data-mark-project-done]') as HTMLButtonElement | null;
  const markDone = () => {
    if (!btn) return;
    btn.textContent = btn.dataset.labelDone ?? '✓ Completed';
    btn.classList.add('is-done');
    btn.disabled = true;
  };
  if (slug && isProjectComplete(slug)) markDone();
  btn?.addEventListener('click', () => {
    if (!slug) return;
    completeProject(slug);
    markDone();
    document.dispatchEvent(new CustomEvent('lesson:complete'));
  });
</script>

<style>
  .project-done { padding: 1.5rem 0 3rem; text-align: center; }
  .project-done__btn { font-size: 1rem; padding: .8rem 1.6rem; }
  .project-done__hint { color: var(--ink-soft); font-size: .82rem; margin-top: .5rem; }
  .project-head__xp--step { opacity: .75; }
  .project-content :global(h2.is-step-done) { color: var(--success-text); position: relative; }
  .project-content :global(h2.is-step-done::after) {
    content: '✅ cleared · +15 XP'; font-size: .72rem; font-weight: 700;
    margin-inline-start: .5rem; color: var(--success-text); vertical-align: middle;
  }
  .project-content :global(.step-clear) {
    margin-inline-start: .6rem; padding: .2rem .7rem; border: 1px solid var(--line);
    border-radius: 999px; background: var(--bg-soft); color: var(--ink-soft);
    font-size: .72rem; font-weight: 700; vertical-align: middle; cursor: pointer;
  }
  .project-content :global(.step-clear:hover),
  .project-content :global(.step-clear:focus-visible) {
    border-color: var(--success); color: var(--success-text); outline: none;
  }
  .project-content :global(h2.is-step-done .step-clear) {
    border-color: var(--success); color: var(--success-text); background: var(--success-soft);
  }
</style>
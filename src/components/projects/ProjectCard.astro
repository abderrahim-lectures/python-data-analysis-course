---
// Shared project card used by every locale's project index. The href goes
// through projectsHref() so locale paths are always correct (Bug B fix).
import {PROJECT_TAGS, projectArtEmoji, projectDifficulty, DIFFICULTY_COLORS, type Difficulty} from '../../lib/projectArt';
import {projectsHref, type Locale} from '../../lib/routeSegments';
import {m} from '../../paraglide/messages.js';

interface Props {
  slug: string;
  title: string;
  description: string;
  locale: Locale;
}

const {slug, title, description, locale} = Astro.props;
const base = import.meta.env.BASE_URL;
const tags = PROJECT_TAGS[slug] ?? [];
const emoji = projectArtEmoji(tags);
const diff: Difficulty = projectDifficulty(slug);
const diffColor = DIFFICULTY_COLORS[diff];
const diffLabel = `difficulty_${diff}` as 'difficulty_beginner' | 'difficulty_intermediate' | 'difficulty_advanced';
const haystack = `${title} ${description} ${tags.join(' ')}`.toLowerCase();
const tagIcon = (t: string): string => projectArtEmoji([t]);
---

<a class="card" href={projectsHref(locale, base, slug)} data-project data-tags={tags.join('|')} data-diff={diff} data-search={haystack}>
  <div class="card__header">
    <span class="card__icon">{emoji}</span>
    <span class={`card__badge card__badge--${diff}`}>{m[diffLabel]()}</span>
  </div>
  <div class="card__body">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="card__tags">
      {tags.slice(0, 3).map((t) => <span class="chip">{tagIcon(t)} {t}</span>)}
    </div>
  </div>
</a>
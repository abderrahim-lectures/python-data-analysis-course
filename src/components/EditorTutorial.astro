---
// Editor Tutorial — contextual coach marks for the web editor.
// Uses a lightweight CSS-only coach-mark system (no external library).
// localStorage key: pda-course:editor-tutorial-seen — once dismissed, never shown again.
// All steps are translatable via data attributes + pageStrings.
interface Props {
  locale?: string;
}
const {locale = 'en'} = Astro.props;
---

<style>
  .tutorial-overlay {
    position: fixed; inset: 0; z-index: 10000;
    pointer-events: none;
    opacity: 0; transition: opacity .3s ease;
  }
  .tutorial-overlay--active { opacity: 1; pointer-events: auto; }
  .tutorial-step {
    position: absolute; pointer-events: auto;
    background: var(--surface); border: 2px solid var(--accent);
    border-radius: var(--radius-lg); padding: 1rem 1.25rem;
    box-shadow: var(--shadow-lg); max-width: 320px;
    font-size: .88rem; line-height: 1.5; color: var(--ink);
    opacity: 0; transform: translateY(10px);
    transition: opacity .3s ease, transform .3s ease;
  }
  .tutorial-step--visible { opacity: 1; transform: translateY(0); }
  .tutorial-step__title { font-weight: 700; font-size: .95rem; margin-bottom: .4rem; color: var(--accent); }
  .tutorial-step__actions { display: flex; gap: .5rem; margin-top: .8rem; }
  .tutorial-step__btn {
    border: none; border-radius: var(--radius-pill); padding: .4rem .9rem;
    font-size: .82rem; font-weight: 600; cursor: pointer; transition: all var(--transition-fast);
  }
  .tutorial-step__btn--primary { background: var(--accent); color: var(--accent-contrast); }
  .tutorial-step__btn--primary:hover { filter: brightness(1.1); }
  .tutorial-step__btn--ghost { background: transparent; color: var(--ink-soft); }
  .tutorial-step__btn--ghost:hover { color: var(--ink); }
  .tutorial-step__dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%;
    background: var(--line); margin-right: 4px; transition: background .2s;
  }
  .tutorial-step__dot--active { background: var(--accent); }
  .tutorial-spotlight {
    position: fixed; z-index: 9999; pointer-events: none;
    border: 3px solid var(--accent); border-radius: var(--radius-md);
    box-shadow: 0 0 0 9999px rgba(0,0,0,.55);
    opacity: 0; transition: opacity .3s ease;
  }
  .tutorial-spotlight--visible { opacity: 1; }
  @media (max-width: 640px) {
    .tutorial-step { max-width: calc(100vw - 2rem); left: 1rem !important; right: 1rem !important; }
    .tutorial-step__actions { flex-direction: column; }
  }
</style>

<div class="tutorial-overlay" id="editor-tutorial" data-locale={locale}>
  <div class="tutorial-spotlight" id="tutorial-spotlight"></div>
  <div class="tutorial-step" id="tutorial-step-0" data-step="0">
    <div class="tutorial-step__title">Welcome to PyDA Course</div>
    <p>You're about to learn Python in your browser — no install needed.</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="next">Get Started →</button>
      <button class="tutorial-step__btn tutorial-step__btn--ghost" data-action="skip">Skip</button>
    </div>
  </div>
  <div class="tutorial-step" id="tutorial-step-1" data-step="1" style="display:none">
    <div class="tutorial-step__title">1. Find the Editor</div>
    <p>This is the code editor area. Click here to start typing Python.</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="next">Next →</button>
      <button class="tutorial-step__btn tutorial-step__btn--ghost" data-action="skip">Skip</button>
    </div>
  </div>
  <div class="tutorial-step" id="tutorial-step-2" data-step="2" style="display:none">
    <div class="tutorial-step__title">2. Click Run</div>
    <p>Click the <strong>▶ Run</strong> button to execute your code. Or press <strong>Ctrl+Enter</strong>.</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="next">Next →</button>
      <button class="tutorial-step__btn tutorial-step__btn--ghost" data-action="skip">Skip</button>
    </div>
  </div>
  <div class="tutorial-step" id="tutorial-step-3" data-step="3" style="display:none">
    <div class="tutorial-step__title">3. Read the Output</div>
    <p>The terminal below shows your code's output and any errors.</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="next">Next →</button>
      <button class="tutorial-step__btn tutorial-step__btn--ghost" data-action="skip">Skip</button>
    </div>
  </div>
  <div class="tutorial-step" id="tutorial-step-4" data-step="4" style="display:none">
    <div class="tutorial-step__title">4. Try It!</div>
    <p>Type <code>print("Hello, World!")</code> and click Run. You just wrote Python!</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="done">Done 🎉</button>
      <button class="tutorial-step__btn tutorial-step__btn--ghost" data-action="skip">Skip</button>
    </div>
  </div>
  <div class="tutorial-step" id="tutorial-step-5" data-step="5" style="display:none">
    <div class="tutorial-step__title">5. Errors Are Normal</div>
    <p>When something goes wrong, Python shows an error message. Read the last line — it tells you what went wrong. Fix it and click Run again.</p>
    <div class="tutorial-step__actions">
      <button class="tutorial-step__btn tutorial-step__btn--primary" data-action="done">Got it! 🎉</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var storageKey = 'pda-course:editor-tutorial-seen';
    var currentStep = parseInt(sessionStorage.getItem('pda-course:tutorial-step') || '0');
    var seen = localStorage.getItem(storageKey);
    if (seen === '1') return;
    var overlay = document.getElementById('editor-tutorial');
    if (!overlay) return;
    var steps = overlay.querySelectorAll('.tutorial-step');
    var spotlight = document.getElementById('tutorial-spotlight');
    var stepEls = overlay.querySelectorAll('.tutorial-step');
    var showStep = function(n) {
      stepEls.forEach(function(el, i) { el.style.display = i === n ? 'block' : 'none'; });
      var active = overlay.querySelector('[data-action="next"], [data-action="done"], [data-action="skip"]');
      if (active) active.click();
      requestAnimationFrame(function() {
        stepEls[n].classList.add('tutorial-step--visible');
      });
      sessionStorage.setItem('pda-course:tutorial-step', String(n));
    };
    var advance = function() {
      stepEls.forEach(function(el) { el.classList.remove('tutorial-step--visible'); });
      currentStep++;
      if (currentStep >= stepEls.length) {
        localStorage.setItem(storageKey, '1');
        sessionStorage.removeItem('pda-course:tutorial-step');
        overlay.classList.remove('tutorial-overlay--active');
        return;
      }
      showStep(currentStep);
    };
    overlay.addEventListener('click', function(e) {
      if (e.target.dataset.action === 'next') advance();
      if (e.target.dataset.action === 'done') {
        localStorage.setItem(storageKey, '1');
        sessionStorage.removeItem('pda-course:tutorial-step');
        overlay.classList.remove('tutorial-overlay--active');
      }
      if (e.target.dataset.action === 'skip') {
        localStorage.setItem(storageKey, '1');
        sessionStorage.removeItem('pda-course:tutorial-step');
        overlay.classList.remove('tutorial-overlay--active');
      }
    });
    setTimeout(function() { overlay.classList.add('tutorial-overlay--active'); showStep(currentStep); }, 800);
  })();
</script>

---
// PopularPages.astro, "most viewed pages" widget powered by the
// popular_pages() Supabase RPC. Hidden entirely when Supabase creds are
// absent or the RPC returns nothing. Localized via message keys.
import {m} from '../paraglide/messages.js';
import type {Locale} from '../lib/routeSegments';

interface Props {
  supabaseUrl?: string;
  supabaseKey?: string;
  locale?: Locale;
}
const {supabaseUrl = '', supabaseKey = ''} = Astro.props;
---

{
  supabaseUrl && supabaseKey && (
    <div class="container">
      <section class="popular-pages" aria-label={m.popular_pages_label()}>
        <h2 class="popular-pages__title">{m.popular_pages_title()}</h2>
        <ol class="popular-pages__list" id="popular-pages-list"></ol>
      </section>
      <script is:inline define:vars={{supabaseUrl, supabaseKey}}>
        (async function () {
          const list = document.getElementById('popular-pages-list');
          if (!list) return;
          try {
            const res = await fetch(`${supabaseUrl}/rest/v1/rpc/popular_pages`, {
              headers: {
                apikey: supabaseKey,
                Authorization: `Bearer ${supabaseKey}`,
                Accept: 'application/json',
              },
            });
            if (!res.ok) return;
            const rows = await res.json();
            if (!Array.isArray(rows) || rows.length === 0) return;
            const frag = document.createDocumentFragment();
            // `path` is anon-writable, so it must never become a live link:
            // only same-origin http(s) paths survive, and only as a pathname.
            const origin = location.origin;
            const MAX_PATH = 200;
            for (const row of rows) {
              if (typeof row !== 'object' || row === null) continue;
              const raw = String(row.path ?? '');
              if (raw.length > MAX_PATH) continue;
              let path;
              try {
                const url = new URL(raw, origin);
                if (url.origin !== origin) continue;
                if (url.protocol !== 'http:' && url.protocol !== 'https:') continue;
                path = url.pathname;
              } catch {
                continue;
              }
              const trimmed = path.replace(/^\/+|\/+$/g, '');
              // Skip bare locale-root paths ("/", "/ar/", "/es/", "/fr/"):
              // just a language code isn't a meaningful "page" for this list.
              if (!trimmed || /^(ar|es|fr)$/.test(trimmed)) continue;
              const li = document.createElement('li');
              li.className = 'popular-pages__item';
              const rank = document.createElement('span');
              rank.className = 'popular-pages__rank';
              rank.textContent = String(frag.childNodes.length + 1);
              const a = document.createElement('a');
              a.className = 'popular-pages__link';
              a.href = path;
              // url.pathname is always percent-encoded (unlike location.pathname,
              // which browsers show decoded), so non-ASCII segments like the
              // Arabic route slugs must be decoded per-segment before display.
              a.textContent = trimmed
                .split('/')
                .map((seg) => {
                  try {
                    return decodeURIComponent(seg);
                  } catch {
                    return seg;
                  }
                })
                .join('/')
                .replace(/-/g, ' ')
                .replace(/\//g, ' › ');
              const views = document.createElement('span');
              views.className = 'popular-pages__views';
              views.textContent = String(row.views);
              li.append(rank, a, views);
              frag.appendChild(li);
            }
            if (frag.childNodes.length) list.appendChild(frag);
          } catch (e) {
            // stats are progressive enhancement; fail silently
          }
        })();
      </script>
    </div>
  )
}

<style is:global>
  /* Global: the list items below are built with document.createElement in
     the inline script, so they never receive Astro's scoped data-astro-cid
     attribute — scoped styles would silently not match them at all. */
  .popular-pages {
    margin-block: 2.5rem;
    padding: 2rem 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 640px) {
    .popular-pages {
      /* Matches .hub__inner's mobile padding (1.15rem) for visual
         consistency with the hub cards above it. */
      margin-block: 1.5rem;
      padding: 1.15rem;
    }
  }
  .popular-pages__title {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .popular-pages__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .15rem;
  }
  .popular-pages__item {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: center;
    gap: .75rem;
    padding: .1rem .5rem;
    border-radius: var(--radius-md);
    transition: background .15s ease;
  }
  .popular-pages__item:hover {
    background: var(--surface-2);
  }
  .popular-pages__rank {
    color: var(--ink-faint);
    font-size: .78em;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .popular-pages__link {
    display: block;
    padding: .1rem 0;
    text-decoration: none;
    color: var(--ink);
    text-transform: capitalize;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .popular-pages__item:hover .popular-pages__link {
    color: var(--accent);
  }
  .popular-pages__views {
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    font-size: .85em;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
---
// LearnerActivity.astro — "N learners online" + most recent completion.
// Rendered in-flow on the homepage only (after PopularPages), not as a
// site-wide fixed bar: the heartbeat/count/recent fetches and their 30s
// polling intervals used to run on every single page via Base.astro, which
// meant lesson/project pages paid for this widget's network traffic without
// ever showing it. Scoping it to the homepage removes that cost from every
// other page.
import {m} from '../paraglide/messages.js';
interface Props {
  locale?: string;
  supabaseUrl?: string;
  supabaseKey?: string;
}
const {locale = 'en', supabaseUrl = '', supabaseKey = ''} = Astro.props;
---

{
  supabaseUrl && supabaseKey && (
    <section class="container learner-activity" id="learner-bar" data-locale={locale} data-url={supabaseUrl} data-key={supabaseKey}
      data-now={m.learner_learning_now()} data-online-one={m.learner_online_one()} data-online-many={m.learner_online_many()}
      role="status" aria-live="polite" hidden>
      <span class="learner-activity__dot" aria-hidden="true"></span>
      <span class="learner-activity__count" id="learner-count">0</span>
      <span class="learner-activity__label" id="learner-label">{m.learner_learning_now()}</span>
      <span class="learner-activity__sep" aria-hidden="true">·</span>
      <span class="learner-activity__recent" id="learner-recent"></span>
      <script is:inline>
        (function () {
          var bar = document.getElementById('learner-bar');
          if (!bar) return;
          var LOCALE = bar.getAttribute('data-locale') || 'en';
          var URL = bar.getAttribute('data-url') || '';
          var KEY = bar.getAttribute('data-key') || '';
          var ONE = bar.getAttribute('data-online-one') || 'learner online';
          var MANY = bar.getAttribute('data-online-many') || 'learners online';
          try {
            if (localStorage.getItem('pda:analytics-consent') === '0') return;
          } catch (e) { return; }
          if (!URL || !KEY) return;
          var HDR = {apikey: KEY, Authorization: 'Bearer ' + KEY, 'Content-Type': 'application/json'};
          var lid;
          try { lid = localStorage.getItem('pda:learner-id'); } catch (e) {}
          if (!lid) {
            lid = crypto.randomUUID ? crypto.randomUUID() : 'x' + Math.random().toString(36).slice(2);
            try { localStorage.setItem('pda:learner-id', lid); } catch (e) {}
          }
          async function beat() {
            try {
              await fetch(URL + '/rest/v1/learners', {
                method: 'POST',
                headers: {...HDR, Prefer: 'resolution=merge-duplicates,return=minimal'},
                body: JSON.stringify({id: lid, last_seen: new Date().toISOString(), locale: LOCALE, track: ''}),
              });
            } catch (e) {}
          }
          async function count() {
            try {
              var c = new Date(Date.now() - 60000).toISOString();
              var r = await fetch(URL + '/rest/v1/learners?last_seen=gt.' + encodeURIComponent(c) + '&select=id', {headers: HDR});
              var d = await r.json();
              return Array.isArray(d) ? d.length : 0;
            } catch (e) { return 0; }
          }
          async function recent() {
            try {
              var r = await fetch(URL + '/rest/v1/completions?order=created_at.desc&limit=1&select=type,slug,created_at', {headers: HDR});
              var d = await r.json();
              return Array.isArray(d) && d.length ? d[0] : null;
            } catch (e) { return null; }
          }
          function ago(iso, locale) {
            try {
              var rtf = new Intl.RelativeTimeFormat(locale, {numeric: 'auto'});
              var secs = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
              if (Math.abs(secs) < 60) return rtf.format(0, 'second');
              if (Math.abs(secs) < 3600) return rtf.format(Math.round(secs / 60), 'minute');
              if (Math.abs(secs) < 86400) return rtf.format(Math.round(secs / 3600), 'hour');
              return rtf.format(Math.round(secs / 86400), 'day');
            } catch (e) { return ''; }
          }
          function lbl(slug) {
            var p = slug.split('/');
            return p.length >= 3 ? p[0].replace(/-/g, ' ') + ' W' + p[2].replace('week-', '') : slug.replace(/-/g, ' ');
          }
          async function refresh() {
            var n = await count();
            var r = await recent();
            var ce = document.getElementById('learner-count'), le = document.getElementById('learner-label'), re = document.getElementById('learner-recent');
            if (ce) ce.textContent = n;
            if (le) le.textContent = n === 1 ? ONE : MANY;
            if (re && r) re.textContent = lbl(r.slug) + ' · ' + ago(r.created_at, LOCALE);
            bar.hidden = n === 0;
          }
          beat();
          refresh();
          setInterval(beat, 30000);
          setInterval(refresh, 30000);
        })();
      </script>
    </section>
  )
}

<style is:global>
  /* Global for the same reason as PopularPages: #learner-bar's children are
     static markup here, but this block also has to match the section itself
     which is created before hydration — kept global for consistency and to
     avoid a second scoping footgun if this ever grows dynamic children. */
  .learner-activity {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    margin-block: 1.25rem 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: .85rem;
    color: var(--ink-soft);
  }
  .learner-activity__dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--success);
    animation: learner-pulse 2s ease-in-out infinite; flex-shrink: 0;
  }
  .learner-activity__count { font-weight: 700; color: var(--ink); }
  .learner-activity__sep { color: var(--line); }
  .learner-activity__recent { color: var(--ink-faint); font-style: italic; }
  @keyframes learner-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
  }
  @media (max-width: 640px) {
    .learner-activity {
      margin-block: 1rem 1.5rem;
      padding: .85rem 1rem;
    }
  }
</style>

---
// LearnerActivity.astro — "N learners online" + most recent completion.
// Rendered in-flow on the homepage only (after PopularPages), not as a
// site-wide fixed bar: the heartbeat/count/recent fetches and their 30s
// polling intervals used to run on every single page via Base.astro, which
// meant lesson/project pages paid for this widget's network traffic without
// ever showing it. Scoping it to the homepage removes that cost from every
// other page.
import {m} from '../paraglide/messages.js';
interface Props {
  locale?: string;
  supabaseUrl?: string;
  supabaseKey?: string;
}
const {locale = 'en', supabaseUrl = '', supabaseKey = ''} = Astro.props;
---

{
  supabaseUrl && supabaseKey && (
    <section class="container learner-activity" id="learner-bar" data-locale={locale} data-url={supabaseUrl} data-key={supabaseKey}
      data-now={m.learner_learning_now()} data-online-one={m.learner_online_one()} data-online-many={m.learner_online_many()}
      role="status" aria-live="polite" hidden>
      <span class="learner-activity__dot" aria-hidden="true"></span>
      <span class="learner-activity__count" id="learner-count">0</span>
      <span class="learner-activity__label" id="learner-label">{m.learner_learning_now()}</span>
      <script is:inline>
        // astro:page-load re-runs this on every soft navigation (the same
        // Astro dedup that meant a single-run guard here would only ever
        // bind to the very first #learner-bar of the session -- any later
        // homepage revisit would render a fresh node this script never
        // touches again). Re-binding on every load means re-entering here
        // more than once per session too, so the previous run's intervals
        // must be cleared first -- otherwise each homepage revisit stacks
        // another pair of 30s pollers on top of the ones from the last visit,
        // none of which ever get cleared on navigating away either.
        function pydaInitLearnerActivity() {
          if (window.__pydaLearnerIntervals) {
            clearInterval(window.__pydaLearnerIntervals.beat);
            clearInterval(window.__pydaLearnerIntervals.refresh);
            window.__pydaLearnerIntervals = null;
          }
          var bar = document.getElementById('learner-bar');
          if (!bar) return;
          var LOCALE = bar.getAttribute('data-locale') || 'en';
          var URL = bar.getAttribute('data-url') || '';
          var KEY = bar.getAttribute('data-key') || '';
          var ONE = bar.getAttribute('data-online-one') || 'learner online';
          var MANY = bar.getAttribute('data-online-many') || 'learners online';
          try {
            if (localStorage.getItem('pda:analytics-consent') === '0') return;
          } catch (e) { return; }
          if (!URL || !KEY) return;
          function getUid() { return window.__pydaUserId || null; }
          function authedFetch(url, init) {
            if (window.__pydaFetch) return window.__pydaFetch(url, init);
            var headers = Object.assign({apikey: KEY, Authorization: 'Bearer ' + KEY}, (init && init.headers) || {});
            return fetch(url, Object.assign({}, init, {headers: headers}));
          }
          function waitForAuth(cb) {
            if (getUid()) { cb(); return; }
            var done = false;
            function guard() { if (!done) { done = true; cb(); } }
            document.addEventListener('pyda:auth-ready', guard, {once: true});
            setTimeout(guard, 3000);
          }
          async function beat() {
            var uid = getUid();
            if (!uid) return;
            try {
              await authedFetch(URL + '/rest/v1/learners', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', Prefer: 'resolution=merge-duplicates,return=minimal'},
                body: JSON.stringify({id: uid, last_seen: new Date().toISOString(), locale: LOCALE, track: ''}),
              });
            } catch (e) {}
          }
          async function count() {
            try {
              var c = new Date(Date.now() - 60000).toISOString();
              // Prefer: count=exact + a 0-row range asks PostgREST for just
              // the Content-Range total, not the matching rows themselves --
              // this widget only ever needs the number, not the row bodies.
              var r = await authedFetch(URL + '/rest/v1/learners?last_seen=gt.' + encodeURIComponent(c) + '&select=id', {
                headers: {Prefer: 'count=exact', Range: '0-0'},
              });
              var range = r.headers.get('content-range'); // "0-0/N"
              var total = range ? parseInt(range.split('/')[1], 10) : NaN;
              return Number.isFinite(total) ? total : 0;
            } catch (e) { return 0; }
          }
          async function refresh() {
            var n = await count();
            var ce = document.getElementById('learner-count'), le = document.getElementById('learner-label');
            if (ce) ce.textContent = n;
            if (le) le.textContent = n === 1 ? ONE : MANY;
            bar.hidden = n === 0;
          }
          waitForAuth(function () {
            beat();
            refresh();
            window.__pydaLearnerIntervals = {
              beat: setInterval(beat, 30000),
              refresh: setInterval(refresh, 30000),
            };
          });
        }
        document.addEventListener('astro:page-load', pydaInitLearnerActivity);
        if (document.readyState === 'complete') pydaInitLearnerActivity();
      </script>
    </section>
  )
}

<style is:global>
  /* Global for the same reason as PopularPages: #learner-bar's children are
     static markup here, but this block also has to match the section itself
     which is created before hydration — kept global for consistency and to
     avoid a second scoping footgun if this ever grows dynamic children. */
  .learner-activity {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    margin-block: 1.25rem 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: .85rem;
    color: var(--ink-soft);
  }
  .learner-activity__dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--success);
    animation: learner-pulse 2s ease-in-out infinite; flex-shrink: 0;
  }
  .learner-activity__count { font-weight: 700; color: var(--ink); }
  @keyframes learner-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
  }
  @media (max-width: 640px) {
    .learner-activity {
      margin-block: 1rem 1.5rem;
      padding: .85rem 1rem;
    }
  }
</style>

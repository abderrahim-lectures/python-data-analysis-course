---
// JupyterLite-style notebook cell — markdown or code, rendered inline.
// For data science lessons that need a notebook-like experience.
interface Props {
  type: 'markdown' | 'code';
  code?: string;
  label?: string;
}
const {type, code = '', label} = Astro.props;
---

{type === 'markdown' ? (
  <div class="nb-cell nb-cell--md" data-nb-cell="md">
    {label && <span class="nb-cell__label">{label}</span>}
    <div class="nb-cell__body">
      <slot />
    </div>
  </div>
) : (
  <div class="nb-cell nb-cell--code" data-nb-cell="code">
    {label && <span class="nb-cell__label">{label}</span>}
    <div class="cell" data-runnable>
      <div class="cell__actions">
        <button class="btn btn-primary cell__run" data-run aria-label="Run this Python code">▶ Run</button>
        <span class="cell__lang">python</span>
      </div>
      <pre class="cell__code"><code>{code}</code></pre>
      <div class="cell__output" data-output hidden>
        <div class="cell__lines" data-lines></div>
        <button class="cell__clear" data-clear hidden>Clear</button>
      </div>
    </div>
  </div>
)}

<style>
  .nb-cell {
    margin: .5rem 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .nb-cell__label {
    display: block;
    padding: .3rem .8rem;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    background: var(--surface-2);
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
  }
  .nb-cell--md .nb-cell__body {
    padding: .8rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: .92rem;
    line-height: 1.6;
  }
  .nb-cell--md .nb-cell__body :global(p) { margin: .4rem 0; }
  .nb-cell--md .nb-cell__body :global(strong) { color: var(--ink); }
  .nb-cell--md .nb-cell__body :global(code) {
    background: var(--surface-2); padding: .15rem .4rem;
    border-radius: var(--radius-sm); font-size: .88rem;
  }
</style>

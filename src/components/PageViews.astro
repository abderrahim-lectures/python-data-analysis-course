---
// PageViews.astro, anonymous page-view logging to Supabase.
// Renders no visible markup; the inline script POSTs one row to the
// `pageviews` table on page load, but only after the visitor opts in via the
// footer analytics toggle (default on) and anonymous auth is ready.
// Uses the user's auth.uid() as learner_id for RLS + rate limiting.
interface Props {
  supabaseUrl?: string;
  supabaseKey?: string;
  locale?: string;
}
const {supabaseUrl = '', supabaseKey = '', locale = 'en'} = Astro.props;
---

{
  supabaseUrl && supabaseKey && (
    <script is:inline define:vars={{supabaseUrl, supabaseKey, viewLocale: locale}}>
      (function () {
        function getUid() { return window.__pydaUserId || null; }
        function send() {
          // Stripped of any trailing slash so "/learn" and "/learn/" record
          // as the same path -- popular_pages() also normalizes this way
          // for pre-existing rows (see migration 011), but recording
          // consistently going forward means the RPC's grouping is doing
          // less work and the raw pageviews table doesn't accumulate
          // needless duplicate path strings for the same page.
          var path = window.location.pathname.replace(/\/+$/, '') || '/';
          if (window.__pydaLastPageViewPath === path) return;
          try {
            if (localStorage.getItem('pda:analytics-consent') === '0') return;
          } catch (e) { return; }
          // The marker used to be written here, before auth was known. On the
          // first load of a session the anonymous sign-in is still in flight,
          // and if it took longer than the old 3s grace the whole pageview was
          // dropped with the path already marked "recorded" -- so a slow first
          // load silently lost the landing page and nothing retried. Now the
          // marker is written when a row is actually posted, and the post is
          // retried once auth announces itself.
          var sent = false;
          function post() {
            if (sent) return;
            var uid = getUid();
            if (!uid) return;
            sent = true;
            window.__pydaLastPageViewPath = path;
            var body = JSON.stringify({path: path, locale: viewLocale, learner_id: uid});
            var doFetch = window.__pydaFetch || fetch;
            doFetch(supabaseUrl + '/rest/v1/pageviews', {
              method: 'POST',
              headers: {
                apikey: supabaseKey,
                Authorization: 'Bearer ' + supabaseKey,
                'Content-Type': 'application/json',
                Prefer: 'return=minimal',
              },
              body: body,
              keepalive: true,
            })
              .then(function (res) {
                if (!res.ok) console.warn('[pyda] pageview not recorded (' + res.status + ')');
              })
              .catch(function () {});
          }
          if (getUid()) { post(); return; }
          document.addEventListener('pyda:auth-ready', post, {once: true});
          // No Supabase anonymous auth configured (or it failed): post() sees
          // no uid and returns, so nothing is recorded and nothing waits.
          setTimeout(post, 3000);
        }
        if (!window.__pydaPageViewListenerBound) {
          window.__pydaPageViewListenerBound = true;
          document.addEventListener('astro:page-load', send);
        }
      })();
    </script>
  )
}

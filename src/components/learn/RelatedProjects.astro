---
// "Put this lesson into practice", links a lesson to the hand-picked
// projects that exercise its skills. The pairing lives in relatedProjects.ts
// (curated, since lesson tags and project tags use different vocabularies).
// Locale-safe: resolves the EN project slug to the matching entry in the
// current locale's tree (collection slugs are `ar/…`, `es/…`, `fr/…`).
import type {CollectionEntry} from 'astro:content';
import {getCollection} from 'astro:content';
import {m} from '../../paraglide/messages.js';
import {projectsHref, type Locale} from '../../lib/routeSegments';
import {relatedProjectSlugs} from '../../lib/relatedProjects';
import {projectArtEmoji} from '../../lib/projectArt';

interface Props {
  locale: Locale;
  section: string;
  track: 'normal' | 'hard';
  lessonSlug: string;
}

const {locale, section, track, lessonSlug} = Astro.props;
const base = import.meta.env.BASE_URL;
const wanted = relatedProjectSlugs(section, track, lessonSlug);

let related: {slug: string; title: string; description: string; tags: string[]}[] = [];
if (wanted.length) {
  const all = await getCollection('projects', ({data}) => Boolean(data.title));
  const byBareSlug = new Map<string, CollectionEntry<'projects'>>();
  for (const p of all) {
    const bare = p.id.replace(/^(ar|es|fr)\//, '').replace(/^\/?projects?\//, '');
    if ((locale === 'en' ? !/^(ar|es|fr)\//.test(p.id) : p.id.startsWith(`${locale}/`)) && !byBareSlug.has(bare)) {
      byBareSlug.set(bare, p);
    }
  }
  related = wanted
    .map((slug) => byBareSlug.get(slug))
    .filter((p): p is CollectionEntry<'projects'> => Boolean(p))
    .map((p) => ({
      slug: p.id.replace(/^(ar|es|fr)\//, '').replace(/^\/?projects?\//, ''),
      title: p.data.title,
      description: p.data.description,
      tags: p.data.tags ?? [],
    }));
}
---

{related.length > 0 && (
  <section class="related-projects" aria-label={m.related_aria_label()}>
    <h2 class="related-projects__title">{m.related_title()}</h2>
    <p class="related-projects__lead">{m.related_lead()}</p>
    <div class="related-projects__grid">
      {related.map((p) => (
        <a class="related-projects__card" href={projectsHref(locale, base, p.slug)}>
          <span class="related-projects__icon">{projectArtEmoji(p.tags)}</span>
          <span class="related-projects__body">
            <strong>{p.title}</strong>
            <small>{p.description}</small>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-projects { margin-top: 2.25rem; }
  .related-projects__title { font-size: 1.1rem; margin-bottom: .25rem; }
  .related-projects__lead { font-size: .9rem; color: var(--ink-soft); margin-bottom: .9rem; }
  .related-projects__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .7rem; }
  .related-projects__card {
    display: flex; gap: .65rem; align-items: flex-start; text-decoration: none;
    padding: .8rem .9rem; border-radius: var(--radius-md);
    background: var(--surface-2); border: 1px solid var(--line);
    transition: border-color .15s ease, background .15s ease, transform .15s ease;
  }
  .related-projects__card:hover { border-color: var(--accent); background: var(--accent-soft); }
  .related-projects__card:active { transform: translateY(1px); }
  .related-projects__card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .related-projects__icon { font-size: 1.35rem; line-height: 1.2; }
  .related-projects__body { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .related-projects__body strong { color: var(--ink); font-size: .92rem; }
  .related-projects__body small { color: var(--ink-soft); font-size: .8rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
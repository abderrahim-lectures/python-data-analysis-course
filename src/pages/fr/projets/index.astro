---
// FR project index — thin wrapper over the shared ProjectListing component.
import {getCollection} from 'astro:content';
import ProjectListing from '../../../components/projects/ProjectListing.astro';

const projects = await getCollection('projects');

const filterStrings = {
  searchPlaceholder: 'Rechercher {n} projets…',
  searchAria: 'Rechercher des projets par titre ou description',
  filterTagAria: 'Filter by tag',
  tagAll: 'Tous',
  filterDiffAria: 'Filter by difficulty',
  diffAll: 'Tous les niveaux',
  diffBeginner: 'Débutant',
  diffIntermediate: 'Intermédiaire',
  diffAdvanced: 'Avancé',
  viewAria: 'View mode',
  viewListAria: 'List view',
  viewGridAria: 'Grid view',
  noMatchPrefix: 'Aucun projet ne correspond à',
  trySearch: 'Essayez une autre recherche ou étiquette.',
};
---

<ProjectListing locale="fr" projects={projects} filterStrings={filterStrings} />
---
// Locale section landing page: /fr/apprendre/python-101, /fr/apprendre/data-analysis.
import {getCollection} from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import {weekHref, learnHref} from '../../../../lib/routeSegments';

const locale = 'fr' as const;

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  const bySection = new Map<string, typeof entries>();
  for (const e of entries) {
    if (e.slug.split('/')[0] !== 'fr' || !e.data.section) continue;
    const list = bySection.get(e.data.section) ?? [];
    list.push(e);
    bySection.set(e.data.section, list);
  }
  return [...bySection.entries()].map(([section, lessons]) => ({params: {section}, props: {section, lessons}}));
}

interface Props { section: string; lessons: Awaited<ReturnType<typeof getCollection<'learn'>>> }
const {section, lessons} = Astro.props;
const base = import.meta.env.BASE_URL;
const dir = 'ltr' as const;

const indexEntry = (await getCollection('learn')).find((e) => e.slug === `fr/${section}/index`);
const title = indexEntry?.data.title ?? section;
const description = indexEntry?.data.description ?? `${section} lessons.`;

const byTrack = (track: 'normal' | 'hard') =>
  lessons
    .filter((e) => e.data.track === track && typeof e.data.week === 'number')
    .sort((a, b) => (a.data.week ?? 0) - (b.data.week ?? 0));
const normalWeeks = byTrack('normal');
const hardWeeks = byTrack('hard');
const alternates = {
  en: `learn/${section}`,
  ar: `ar/تعلم/${section}`,
  es: `es/aprender/${section}`,
  fr: `fr/apprendre/${section}`,
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} alternates={alternates}>
  <nav class="crumb container">
    <a href={learnHref(locale, base)}>{title}</a> <span>/</span> <span class="crumb__here">{title}</span>
  </nav>

  <section class="container head">
    <h1>{title}</h1>
    <p>{description}</p>
  </section>

  <section class="container tracks">
    <div class="track">
      <h2>🌿 Normal</h2>
      <div class="weeks">
        {normalWeeks.map((w) => (
          <a class="week" href={weekHref(locale, base, section, 'normal', w.data.week!)}>
            <span class="week__num">Week {w.data.week}</span>
            <span class="week__title">{w.data.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="track">
      <h2>⚡ Hard</h2>
      <div class="weeks">
        {hardWeeks.map((w) => (
          <a class="week" href={weekHref(locale, base, section, 'hard', w.data.week!)}>
            <span class="week__num">Week {w.data.week}</span>
            <span class="week__title">{w.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .head { padding: 1.5rem 0; }
  .head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .3rem 0; }
  .head p { color: var(--ink-soft); }
  .tracks { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 3rem; }
  .track h2 { font-size: 1.1rem; margin-bottom: .8rem; }
  .weeks { display: flex; flex-direction: column; gap: .6rem; }
  .week {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: .8rem 1rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column;
    box-shadow: var(--shadow-sm); transition: all var(--transition-smooth);
  }
  .week:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .week__num { color: var(--accent); font-weight: 700; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .week__title { font-weight: 600; }
  @media (max-width: 640px) { .tracks { grid-template-columns: 1fr; } }
</style>

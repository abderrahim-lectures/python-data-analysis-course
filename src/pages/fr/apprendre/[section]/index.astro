---
// Locale section landing: /fr/apprendre/[section]. Thin wrapper — all markup lives in SectionLanding.
import {getCollection} from 'astro:content';
import SectionLanding from '../../../../components/learn/SectionLanding.astro';
const locale = 'fr' as const;

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  const sections = [...new Set(modules.map((m) => m.slug.split('/')[0]))].sort();
  return sections.map((section) => ({params: {section}, props: {section}}));
}
---
<SectionLanding locale={locale} section={Astro.props.section} />
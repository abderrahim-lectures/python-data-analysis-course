---
// AR project index — thin wrapper over the shared ProjectListing component.
import {getCollection} from 'astro:content';
import ProjectListing from '../../../components/projects/ProjectListing.astro';

const projects = await getCollection('projects');

const filterStrings = {
  searchPlaceholder: 'ابحث بين {n} مشروعاً…',
  searchAria: 'ابحث عن المشاريع',
  filterTagAria: 'Filter by tag',
  tagAll: 'الكل',
  filterDiffAria: 'Filter by difficulty',
  diffAll: 'جميع المستويات',
  diffBeginner: 'مبتدئ',
  diffIntermediate: 'متوسط',
  diffAdvanced: 'متقدم',
  viewAria: 'View mode',
  viewListAria: 'List view',
  viewGridAria: 'Grid view',
  noMatchPrefix: 'لا توجد مشاريع تطابق',
  trySearch: 'جرّب بحثاً أو وصفاً مختلفاً.',
};
---

<ProjectListing locale="ar" projects={projects} filterStrings={filterStrings} />
---
// Track hub: /ar/تعلم/python-101/صعب. Thin wrapper — all markup lives in TrackHub.
import {getCollection} from 'astro:content';
import TrackHub from '../../../../../components/learn/TrackHub.astro';
import {bareId, idInLocale, trackWord} from '../../../../../lib/routeSegments';
const locale = 'ar' as const;

export async function getStaticPaths() {
  const locale = 'ar' as const;
  const modules = await getCollection('modules');
  const tracks = [...new Set(
    modules
      .filter((m) => idInLocale(locale, m.id) && bareId(m.id).split('/')[0] === 'python-101')
      .map((m) => bareId(m.id).split('/')[1] as 'normal' | 'hard'),
  )];
  return tracks.map((track) => ({params: {track: trackWord(locale, track)}, props: {track}}));
}
---
<TrackHub locale={locale} section="python-101" track={Astro.props.track} />
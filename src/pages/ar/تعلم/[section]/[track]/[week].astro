---
// Locale-prefixed lesson route: /ar/تعلم/<section>/<track-word>/week-<n>.
// Mirrors src/pages/learn/[section]/[track]/[week].astro (the EN route) but
// reads from the locale-nested content collection entries and uses
// locale-translated track words in the URL (canonical 'normal'/'hard'
// still drive gameState's lessonId — see the comment below).
import {getCollection, type CollectionEntry} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import {PAGE_STRINGS} from '../../../../../lib/pageStrings';
import {weekHref, learnHref, TRACK_WORDS} from '../../../../../lib/routeSegments';

const locale = 'ar' as const;

export async function getStaticPaths() {
  const trackWords = TRACK_WORDS.ar;
  const entries = await getCollection('learn');
  return entries
    .filter((e) => e.slug.split('/')[0] === 'ar' && e.data.track && e.data.week)
    .map((entry) => {
      const parts = entry.slug.split('/');
      const week = parts[parts.length - 1];
      const track = entry.data.track === 'hard' ? trackWords.hard : trackWords.normal;
      const section = entry.data.section!;
      return {
        params: {section, track, week},
        props: {entry},
      };
    });
}

interface Props { entry: CollectionEntry<'learn'> }
const {entry} = Astro.props;
const {title, description, week, track, section} = entry.data;
const {Content} = await entry.render();
const base = import.meta.env.BASE_URL;
const dir = 'rtl' as const;

const allLessons = await getCollection('learn');
const siblings = allLessons
  .filter((e) => e.slug.startsWith('ar/') && e.data.section === section && e.data.track === track && typeof e.data.week === 'number')
  .sort((a, b) => (a.data.week ?? 0) - (b.data.week ?? 0));
const idx = siblings.findIndex((e) => e.slug === entry.slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;
const otherTrack = track === 'normal' ? 'hard' : 'normal';
// Same lessonId shape as the EN route (locale-agnostic, and independent of
// which word the URL uses for the track) — progress/XP is shared across
// locales for the same lesson, not tracked per-language or per-URL-word.
const ps = PAGE_STRINGS['ar'];
const lessonId = `${section}/${track}/week-${week}`;
const alternates = {
  en: `learn/${section}/${track}/week-${week}`,
  ar: `ar/تعلم/${section}/${track === 'hard' ? TRACK_WORDS.ar.hard : TRACK_WORDS.ar.normal}/week-${week}`,
  es: `es/aprender/${section}/${track === 'hard' ? TRACK_WORDS.es.hard : TRACK_WORDS.es.normal}/week-${week}`,
  fr: `fr/apprendre/${section}/${track === 'hard' ? TRACK_WORDS.fr.hard : TRACK_WORDS.fr.normal}/week-${week}`,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: title,
  description,
  learningResourceType: 'Lesson',
  educationalLevel: track === 'hard' ? 'Advanced' : 'Beginner',
  isAccessibleForFree: true,
  inLanguage: locale,
  url: String(new URL(`${base}${alternates.ar}`, Astro.site)),
  position: week,
  isPartOf: {
    '@type': 'Course',
    name: 'PyDA Course',
    description: 'Learn Python and data analysis in your browser — run real code, earn XP, build streaks.',
  },
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} alternates={alternates} jsonLd={jsonLd}>
  <nav class="crumb container">
    <a href={learnHref(locale, base)}>{section}</a> <span>/</span>
    <a href={learnHref(locale, base, section!)}>{section}</a> <span>/</span>
    <span class="crumb__here">Week {week}</span>
  </nav>

  <article class="container lesson-body" data-lesson-id={lessonId}>
    <header class="lesson-head">
      <span class="lesson-head__week">{section} · {track === 'normal' ? 'Normal' : 'Hard'} Track</span>
      <h1>{title}</h1>
      {description && <p class="lesson-head__sub">{description}</p>}
    </header>

    <div class="lesson-content">
      <Content />
    </div>

    <div class="lesson-nav">
      {prev
        ? <a class="lesson-nav__prev" href={weekHref(locale, base, section!, track!, prev.data.week!)}>← Week {prev.data.week}</a>
        : <span />}
      {next
        ? <a class="lesson-nav__next" href={weekHref(locale, base, section!, track!, next.data.week!)}>Week {next.data.week} →</a>
        : <span />}
      <button class="btn btn-soft lesson-nav__done" data-mark-complete
        data-label-done={ps.completed}>{ps.markComplete}</button>
    </div>

    <div class="route">
      <a class="route__card" href={weekHref(locale, base, section!, otherTrack, week!)}>
        <span class="route__icon">{otherTrack === 'hard' ? '⚡' : '🌿'}</span>
        <strong>Switch to {otherTrack === 'hard' ? 'Hard' : 'Normal'}</strong>
        <small>Same week, {otherTrack === 'hard' ? 'steeper climb' : 'gentler pace'}.</small>
      </a>
    </div>
  </article>
</Base>

<script>
  import {completeLesson, isLessonComplete} from '../../../../../lib/gameState';
  const article = document.querySelector('[data-lesson-id]');
  const id = article?.getAttribute('data-lesson-id');
  const btn = document.querySelector('[data-mark-complete]') as HTMLButtonElement | null;

  const markDone = () => {
    if (!btn) return;
    btn.textContent = btn.dataset.labelDone ?? 'Completed';
    btn.classList.add('is-done');
    btn.disabled = true;
  };

  if (id && isLessonComplete(id)) markDone();

  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!id) return;
    completeLesson(id);
    markDone();
    document.dispatchEvent(new CustomEvent('lesson:complete'));
  });
</script>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .lesson-head { margin: 1.5rem 0 1rem; }
  .lesson-head__week { color: var(--accent); font-weight: 800; letter-spacing: .04em; text-transform: uppercase; font-size: .8rem; }
  .lesson-head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .3rem 0; }
  .lesson-head__sub { color: var(--ink-soft); font-size: 1.05rem; }
  .lesson-content :global(h2) { margin-top: 2.2rem; }
  .lesson-content :global(.gamified-flourish) { display: block; background: var(--accent-soft); color: var(--accent-text); border-radius: var(--radius-md); padding: .8rem 1rem; margin: 1rem 0; font-weight: 600; }
  .lesson-nav { display: flex; justify-content: space-between; align-items: center; margin: 2rem 0; gap: 1rem; }
  .lesson-nav a { text-decoration: none; font-weight: 700; padding: .6rem 1.1rem; border-radius: var(--radius-pill); background: var(--surface); border: 1px solid var(--line); color: var(--ink); box-shadow: var(--shadow-sm); }
  .lesson-nav__next--done { background: var(--success-soft); color: var(--success); border-color: rgba(88,204,2,.3); }
  .route { display: grid; margin: 1.5rem 0 3rem; }
  .route__card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.2rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: .3rem; box-shadow: var(--shadow-sm); transition: transform .2s ease, box-shadow .2s ease; }
  .route__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .route__card small { color: var(--ink-soft); }
  .route__icon { font-size: 1.6rem; }
</style>

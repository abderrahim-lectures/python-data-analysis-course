---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="تقدمي — PyDA Course" lang="ar" dir="rtl">
  <section class="hero">
    <div class="container head">
      <h1>تتبّع تقدّمك</h1>
      <p>كل درس يُضاء محطة. نقاط الخبرة، السلاسل، والأوسمة تتبعك.</p>
      <a class="btn btn-primary" href={`${base}progress`} style="margin-top:1rem">فتح صفحة التقدّم ←</a>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { xpProgress, trackProgress, questsToShow, streakProgress } from '../lib/gameState.ts';
import { emptyStats } from '../lib/gamestats.ts';
const base = import.meta.env.BASE_URL;
const gs = emptyStats();

const xp = xpProgress();
const py = trackProgress('python-101', 5);
const da = trackProgress('data-analysis', 5);
const quests = questsToShow();
const sp = streakProgress();

const pyWeeks = [1,2,3,4,5].map((w) => {
  const done = w <= py.done;
  return {w, done};
});
const daWeeks = [6,7,8,9,10].map((w) => {
  const done = w <= (5 + da.done);
  return {w, done};
});
---

<Base title="Progress — PyDA Course" lang="en" dir="ltr">
  <section class="hero">
    <div class="container head">
      <div class="head__eyebrow"><Icon name="trophy" size={16} /> Your trail</div>
      <h1>Track your climb</h1>
      <p>Every lesson lights up a station. XP, streaks, and badges move with you.</p>
    </div>
  </section>

  <section class="container">
    <!-- Player card -->
    <div class="player-card" id="progress-player">
      <div class="player-card__left">
        <div class="player-card__avatar">🧑‍💻</div>
        <div class="player-card__info">
          <div class="player-card__rank"><span class="badge badge--streak" id="p-rank">🌱 Bronze</span></div>
          <div class="player-card__level">Lv.<span id="p-level">{xp.level}</span></div>
        </div>
      </div>
      <div class="player-card__xp">
        <div class="player-card__xpbar" role="progressbar" aria-label="XP progress">
          <div class="player-card__xpfill" id="p-xpfill" style="width:{xp.pct}%"></div>
        </div>
        <div class="player-card__xptext"><span id="p-xp">{xp.xp}</span> XP · <span id="p-xpnext">{xp.toNext}</span> to next</div>
      </div>
      <div class="player-card__stats">
        <div class="player-card__stat">
          <span class="player-card__stat-val" id="p-streak">{sp.current}🔥</span>
          <span class="player-card__stat-label">streak</span>
        </div>
        <div class="player-card__stat">
          <span class="player-card__stat-val" id="p-best">{sp.best}</span>
          <span class="player-card__stat-label">best</span>
        </div>
        <div class="player-card__stat">
          <span class="player-card__stat-val" id="p-quests">{quests.filter((q) => q.done).length}/{quests.length}</span>
          <span class="player-card__stat-label">quests</span>
        </div>
      </div>
    </div>

    <!-- XP bar -->
    <div class="xpbar-wrap">
      <div class="xpbar" role="progressbar" aria-label="XP progress" aria-valuenow={xp.pct} aria-valuemin="0" aria-valuemax="100" id="xpbar">
        <div class="xpbar__fill" id="xpbar-fill" style="width:{xp.pct}%"></div>
      </div>
      <span class="xpbar__text" id="xpbar-text">{xp.xp} XP</span>
    </div>

    <!-- Milestones -->
    <div class="milestones" id="milestones"></div>
  </section>

  <!-- Trails -->
  <section class="container">
    <div class="trails">
      <div class="trail">
        <div class="trail__head">
          <div>
            <h2>🐍 Python 101</h2>
            <span class="trail__meta">Variables → functions → language model</span>
          </div>
          <span class="trail__pct" id="pct-python-101">{py.done}/{py.total} done</span>
        </div>
        <ol class="stations" data-track="python-101">
          {pyWeeks.map(({w, done}) => (
            <li class="station{done ? ' station--done' : ''}" data-week={w}>
              <a class="station__link" href={`${base}learn/python-101/normal/week-${w}`}>
                <span class="station__dot"></span>
                <span class="station__label">Week {w}</span>
                <span class="station__check">✅</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="trail__xp" id="xp-python-101">+{py.done * 20} XP earned</div>
      </div>

      <div class="trail">
        <div class="trail__head">
          <div>
            <h2>📊 Pandas &amp; Data</h2>
            <span class="trail__meta">Kaggle-style notebook with pandas</span>
          </div>
          <span class="trail__pct" id="pct-data-analysis">{da.done}/{da.total} done</span>
        </div>
        <ol class="stations" data-track="data-analysis">
          {daWeeks.map(({w, done}) => (
            <li class="station{done ? ' station--done' : ''}" data-week={w}>
              <a class="station__link" href={`${base}learn/data-analysis/normal/week-${w}`}>
                <span class="station__dot"></span>
                <span class="station__label">Week {w}</span>
                <span class="station__check">✅</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="trail__xp trail__xp--streak" id="xp-data-analysis">+{da.done * 20} XP earned</div>
      </div>
    </div>
  </section>

  <!-- Quests -->
  <section class="container">
    <div class="quests">
      <div class="quests__head">
        <h2>Quests</h2>
        <span class="badge badge--accent" id="quests-pct">{quests.filter((q) => q.done).length}/{quests.length} done</span>
      </div>
      <p class="quests__legend">
        Milestones that unlock on their own as you learn — 🔒 just means not yet.
      </p>
      <div class="quest-grid" id="quest-grid">
        {quests.map((q) => (
          <div class={`quest${!q.done ? ' quest--locked' : ''}`} data-quest={q.id}>
            <span class="quest__icon">{q.done ? '✅' : '🔒'}</span>
            <span class="quest__label">{q.label}</span>
            <span class="quest__check">✓</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Improvement report -->
  <section class="container">
    <div class="report">
      <div class="report__empty" id="report-empty">
        <span class="report__empty-icon" aria-hidden="true">📈</span>
        <h2>Your improvement report</h2>
        <p>Complete your first lesson and this fills in with your own numbers —
           accuracy, consistency, and how far you've climbed.</p>
        <a class="btn btn-primary" href={`${base}learn`}>Start your first lesson</a>
      </div>

      <div class="report__body" id="report-body" hidden>
      <div class="report__head">
        <h2>📈 Improvement report</h2>
        <span class="report__kda" id="r-kda-label">{gs.kda.label}</span>
      </div>
      <p class="report__lede">
        How you're climbing vs. a proven learning-science benchmark
        (<a href="https://doi.org/10.58477/dj.v4i1.348" target="_blank" rel="noreferrer">Prayoga et&nbsp;al., 2026</a>).
      </p>

      <div class="kpis">
        <div class="kpi">
          <span class="kpi__label">Win rate</span>
          <span class="kpi__value" id="r-winrate">{gs.quiz.winRate}%</span>
          <span class="kpi__sub" id="r-winrate-sub">quiz accuracy</span>
          <span class="kpi__hint" title="Percentage of quiz questions you answered correctly. Higher = better understanding.">?</span>
        </div>
        <div class="kpi">
          <span class="kpi__label">K/D/A</span>
          <span class="kpi__value" id="r-kda">{gs.kda.kills}/{gs.kda.deaths}/{gs.kda.assists}</span>
          <span class="kpi__sub" id="r-kda-ratio">ratio {gs.kda.ratio}</span>
        </div>
        <div class="kpi">
          <span class="kpi__label">Farm</span>
          <span class="kpi__value" id="r-farm">{gs.lessonsDone}/{gs.lessonsTotal}</span>
          <span class="kpi__sub">lessons cleared</span>
        </div>
      </div>

      <div class="activity-grid">
        <div class="activity-card">
          <div class="activity-card__icon">📅</div>
          <div class="activity-card__content">
            <span class="activity-card__label">Days active</span>
            <span class="activity-card__value" id="r-days-active">{gs.activity.daysActive}</span>
          </div>
        </div>
        <div class="activity-card">
          <div class="activity-card__icon">📊</div>
          <div class="activity-card__content">
            <span class="activity-card__label">Lessons/week</span>
            <span class="activity-card__value" id="r-lessons-week">{gs.activity.lessonsPerWeek}</span>
          </div>
        </div>
        <div class="activity-card">
          <div class="activity-card__icon">⚡</div>
          <div class="activity-card__content">
            <span class="activity-card__label">Avg XP/day</span>
            <span class="activity-card__value" id="r-xp-day">{gs.activity.avgXpPerDay}</span>
          </div>
        </div>
        <div class="activity-card">
          <div class="activity-card__icon">🎯</div>
          <div class="activity-card__content">
            <span class="activity-card__label">Consistency</span>
            <span class="activity-card__value" id="r-consistency">{gs.activity.consistencyScore}%</span>
          </div>
        </div>
      </div>

      <div class="engagement-row">
        <div class="engagement-item">
          <span class="engagement-item__label">Return rate</span>
          <span class="engagement-item__value" id="r-return-rate">{gs.engagement.returnRate}%</span>
          <span class="engagement-item__sub">days you came back</span>
        </div>
        <div class="engagement-item">
          <span class="engagement-item__label">Current streak</span>
          <span class="engagement-item__value" id="r-streak-length">{gs.engagement.streakLength} days</span>
          <span class="engagement-item__sub">consecutive learning</span>
        </div>
        <div class="engagement-item">
          <span class="engagement-item__label">Best session</span>
          <span class="engagement-item__value" id="r-longest-session">{gs.engagement.longestSession} lessons</span>
          <span class="engagement-item__sub">in one sitting</span>
        </div>
      </div>

      <div class="diag" id="r-diag">
        <div class="diag__row">
          <span class="diag__name">Progress (improvement)</span>
          <div class="diag__bar"><div class="diag__fill" id="r-diag-improvement" style={`width:${gs.diagnostics.improvementPct}%`}></div></div>
          <span class="diag__val" id="r-diag-improvement-val">{gs.diagnostics.improvementPct}%</span>
        </div>
        <div class="diag__row">
          <span class="diag__name">Gain vs study (N-Gain)</span>
          <div class="diag__bar"><div class="diag__fill" id="r-diag-ngain" style="width:0%"></div></div>
          <span class="diag__val" id="r-diag-ngain-val">{gs.diagnostics.nGainEquivalent.toFixed(2)}</span>
        </div>
        <div class="diag__row">
          <span class="diag__name">Acceptance (motivation)</span>
          <div class="diag__bar"><div class="diag__fill" id="r-diag-acceptance" style={`width:${gs.diagnostics.acceptancePct}%`}></div></div>
          <span class="diag__val" id="r-diag-acceptance-val">{gs.diagnostics.acceptancePct}%</span>
        </div>
        <div class="diag__row">
          <span class="diag__name">Usefulness (accuracy)</span>
          <div class="diag__bar"><div class="diag__fill" id="r-diag-usefulness" style={`width:${gs.diagnostics.usefulnessPct}%`}></div></div>
          <span class="diag__val" id="r-diag-usefulness-val">{gs.diagnostics.usefulnessPct}%</span>
        </div>
        <div class="diag__row">
          <span class="diag__name">Learning experience</span>
          <div class="diag__bar"><div class="diag__fill" id="r-diag-experience" style={`width:${gs.diagnostics.learningExperiencePct}%`}></div></div>
          <span class="diag__val" id="r-diag-experience-val">{gs.diagnostics.learningExperiencePct}%</span>
        </div>
      </div>

      <p class="report__footnote">
        In the study, students improved from 41.5% &rarr; 76.9% after the course (N-Gain 0.61).
        Your numbers above are <strong>your own</strong>, computed from everything you've done here.
      </p>
      </div>
    </div>
  </section>

  <script>
    // Everything on this page (stations, quests, milestones, XP/streak/rank)
    // is computed at build time with zero data — there's no localStorage in
    // the Node/SSG build — so the static HTML always shows a fresh-account
    // skeleton. This hydrates it with the visitor's real progress on load.
    import {xpProgress, questsToShow, streakProgress, isWeekComplete, rankFor, RANK_EMOJIS} from '../lib/gameState.ts';
    import {computeGameStats} from '../lib/gamestats.ts';

    function render() {
      const xp = xpProgress();
      const sp = streakProgress();
      const quests = questsToShow();
      const rank = rankFor(xp.xp);

      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      set('p-xp', String(xp.xp));
      set('p-xpnext', String(xp.toNext));
      set('p-level', String(xp.level));
      set('p-streak', `${sp.current}🔥`);
      set('p-best', String(sp.best));
      set('p-quests', `${quests.filter((q) => q.done).length}/${quests.length}`);
      const xpfill = document.getElementById('p-xpfill') as HTMLElement | null;
      if (xpfill) xpfill.style.width = xp.pct + '%';
      const rankEl = document.getElementById('p-rank');
      if (rankEl) rankEl.innerHTML = `${RANK_EMOJIS[rank] ?? '🌱'} ${rank}`;

      const xpbarFill = document.getElementById('xpbar-fill') as HTMLElement | null;
      if (xpbarFill) xpbarFill.style.width = xp.pct + '%';
      set('xpbar-text', `${xp.xp} XP`);

      // Tracks: mark each station done/undone, update the "N/5 done" and
      // "+N XP earned" text per track.
      for (const [section, weeks] of [['python-101', [1, 2, 3, 4, 5]], ['data-analysis', [6, 7, 8, 9, 10]]] as const) {
        const list = document.querySelector(`.stations[data-track="${section}"]`);
        let done = 0;
        weeks.forEach((w) => {
          const complete = isWeekComplete(section, w);
          if (complete) done++;
          const li = list?.querySelector(`li[data-week="${w}"]`);
          li?.classList.toggle('station--done', complete);
        });
        set(`pct-${section}`, `${done}/${weeks.length} done`);
        set(`xp-${section}`, `+${done * 20} XP earned`);
      }

      // Quests grid + milestones preview.
      quests.forEach((q) => {
        const el = document.querySelector(`.quest[data-quest="${q.id}"]`);
        if (!el) return;
        el.classList.toggle('quest--locked', !q.done);
        const icon = el.querySelector('.quest__icon');
        if (icon) icon.textContent = q.done ? '✅' : '🔒';
      });
      set('quests-pct', `${quests.filter((q) => q.done).length}/${quests.length} done`);

      const milestones = document.getElementById('milestones');
      if (milestones) {
        const done = quests.filter((q) => q.done).slice(0, 6);
        const locked = quests.filter((q) => !q.done).slice(0, 3);
        milestones.innerHTML = [
          ...done.map((q) => `<span class="badge badge--success">✅ ${q.label}</span>`),
          ...locked.map((q) => `<span class="badge badge--locked">🔒 ${q.label}</span>`),
        ].join('');
      }

      // Improvement report (merged in from the old /stats page).
      const gs = computeGameStats();
      const fmt = (pct: number) => `${Math.max(0, Math.min(100, Math.round(pct)))}%`;
      const fillWidth = (id: string, pct: number) => {
        const el = document.getElementById(id) as HTMLElement | null;
        if (el) el.style.width = fmt(pct);
      };
      // A fresh visitor was shown 0% win rate, 0/0/0 K/D/A and empty bars under
      // a confident benchmark headline, which reads as broken rather than empty.
      const hasProgress = xp.xp > 0;
      const emptyEl = document.getElementById('report-empty');
      const bodyEl = document.getElementById('report-body');
      if (emptyEl) emptyEl.hidden = hasProgress;
      if (bodyEl) bodyEl.hidden = !hasProgress;

      set('r-kda-label', gs.kda.label);
      set('r-winrate', fmt(gs.quiz.winRate));
      set('r-winrate-sub', `${gs.quiz.correct}/${gs.quiz.total} correct`);
      set('r-kda', `${gs.kda.kills}/${gs.kda.deaths}/${gs.kda.assists}`);
      set('r-kda-ratio', `ratio ${gs.kda.ratio}`);
      set('r-farm', `${gs.lessonsDone}/${gs.lessonsTotal}`);
      fillWidth('r-diag-improvement', gs.diagnostics.improvementPct);
      set('r-diag-improvement-val', fmt(gs.diagnostics.improvementPct));
      fillWidth('r-diag-ngain', gs.diagnostics.nGainEquivalent * 100);
      set('r-diag-ngain-val', gs.diagnostics.nGainEquivalent.toFixed(2));
      fillWidth('r-diag-acceptance', gs.diagnostics.acceptancePct);
      set('r-diag-acceptance-val', fmt(gs.diagnostics.acceptancePct));
      fillWidth('r-diag-usefulness', gs.diagnostics.usefulnessPct);
      set('r-diag-usefulness-val', fmt(gs.diagnostics.usefulnessPct));
      fillWidth('r-diag-experience', gs.diagnostics.learningExperiencePct);
      set('r-diag-experience-val', fmt(gs.diagnostics.learningExperiencePct));

      // Activity metrics
      set('r-days-active', String(gs.activity.daysActive));
      set('r-lessons-week', String(gs.activity.lessonsPerWeek));
      set('r-xp-day', String(gs.activity.avgXpPerDay));
      set('r-consistency', fmt(gs.activity.consistencyScore));

      // Engagement metrics
      set('r-return-rate', fmt(gs.engagement.returnRate));
      set('r-streak-length', `${gs.engagement.streakLength} days`);
      set('r-longest-session', `${gs.engagement.longestSession} lessons`);
    }
    render();
  </script>
</Base>

<style>
  .hero { padding: 2.5rem 0 1.5rem; }
  .head__eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; display: inline-flex; align-items: center; gap: .3rem; }
  .head h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: .4rem 0 .2rem; }
  .head p { color: var(--ink-soft); }

  /* Player card */
  .player-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 1.25rem; margin-bottom: 1.25rem; box-shadow: var(--shadow-md);
    display: flex; flex-direction: column; gap: .75rem;
    animation: slide-up .5s cubic-bezier(.34,1.56,.64,1);
  }
  .player-card__left { display: flex; align-items: center; gap: .75rem; }
  .player-card__avatar {
    font-size: 2rem; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
    background: var(--bg-soft); border-radius: var(--radius-md); border: 2px solid var(--line);
  }
  .player-card__info { display: flex; flex-direction: column; gap: .2rem; }
  .player-card__level { font-family: var(--font-display); font-weight: 800; font-size: .85rem; color: var(--ink-soft); }
  .player-card__xp { display: flex; flex-direction: column; gap: 3px; }
  .player-card__xpbar { height: 8px; background: var(--surface-2); border-radius: var(--radius-pill); overflow: hidden; }
  .player-card__xpfill { height: 100%; width: 0; border-radius: var(--radius-pill); background: linear-gradient(90deg, var(--accent), var(--accent-strong)); transition: width .6s cubic-bezier(.4,0,.2,1); }
  .player-card__xptext { font-size: .72rem; font-weight: 700; color: var(--ink-soft); }
  .player-card__stats { display: flex; gap: 1.5rem; }
  .player-card__stat { display: flex; flex-direction: column; align-items: center; gap: .1rem; }
  .player-card__stat-val { font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; color: var(--ink-hi); }
  .player-card__stat-label { font-size: .78rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; }

  /* XP bar */
  .xpbar-wrap { display: flex; align-items: center; gap: .6rem; margin-bottom: 1.5rem; }
  .xpbar { flex: 1; height: 12px; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-pill); overflow: hidden; position: relative; }
  .xpbar__fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-strong)); border-radius: var(--radius-pill); transition: width .6s ease; }
  .xpbar__text { flex: none; font-size: .78rem; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* Milestones */
  .milestones { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }

  /* Trails */
  .trails { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 3rem; }
  .trail { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.25rem; box-shadow: var(--shadow-sm); transition: box-shadow var(--transition-smooth); }
  .trail:hover { box-shadow: var(--shadow-md); }
  .trail__head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
  .trail__head h2 { font-size: 1.15rem; margin: 0; }
  .trail__meta { color: var(--ink-soft); font-size: .8rem; margin-top: .15rem; }
  .trail__pct { color: var(--streak-text); font-weight: 800; font-size: .85rem; white-space: nowrap; }
  .stations { list-style: none; padding: 0; margin: 0 0 .75rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(52px, 1fr)); gap: .5rem; }
  .station__link { display: flex; flex-direction: column; align-items: center; gap: .3rem; text-decoration: none; color: var(--ink-soft); padding: .75rem .5rem; border-radius: var(--radius-md); border: 2px solid var(--line); background: var(--bg); transition: all var(--transition-fast); position: relative; }
  .station__link:hover { transform: translateY(-2px); border-color: var(--accent); background: var(--accent-soft); }
.station__link:active { transform: translateY(0); border-color: var(--accent); background: var(--accent-soft); }
.station__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .station--done .station__link { border-color: var(--accent); background: var(--accent-soft); }
  .station__dot { width: 14px; height: 14px; border-radius: 50%; border: 3px solid var(--line); background: var(--bg); transition: all var(--transition-fast); }
  .station--done .station__dot { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 8px var(--accent-soft); }
  .station__label { font-size: .78rem; font-weight: 700; }
  .station__check { font-size: .7rem; display: none; }
  .station--done .station__check { display: inline; }
.trail__xp { font-size: .75rem; font-weight: 700; color: var(--ink-soft); }
.trail__xp--streak { color: var(--ink); }

  /* Quests */
  .quests { margin-bottom: 3rem; }
  .quests__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .quests h2 { margin: 0; }
  .quests__legend { color: var(--ink-soft); font-size: .85rem; margin: .1rem 0 .9rem; }
  .quest-grid { display: flex; flex-wrap: wrap; gap: .6rem; }

---
// Locale learn hub: /<locale>/learn.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';

export function getStaticPaths() {
  const LOCALES = ['ar', 'es', 'fr'];
  return LOCALES.map((locale) => ({params: {locale}}));
}

const {locale} = Astro.params;
const base = import.meta.env.BASE_URL;
const dir = locale === 'ar' ? 'rtl' : 'ltr';
---

<Base title="Learn — PyDA" lang={locale} dir={dir}>
  <section class="hero">
    <div class="container head">
      <div class="head__eyebrow"><Icon name="code" size={16} /> Your learning trail</div>
      <h1>Two tracks. Two routes. Pick your path.</h1>
      <p>Each lesson earns XP. Streaks multiply it. Badges mark your climb.</p>
    </div>
  </section>

  <section class="container">
    <div class="sections">
      <div class="sectioncard">
        <div class="sectioncard__badge">🐍 Track 1</div>
        <div class="sectioncard__icon">🐍</div>
        <h2>Python 101</h2>
        <p>Weeks 1–5. The fundamentals: variables, types, control flow, functions — then a tiny language model.</p>
        <div class="routes">
          <span class="routes__label">Choose your route:</span>
          <div class="routes__pills">
            <a class="route-pill route-pill--normal" href={`${base}${locale}/learn/python-101/normal/week-1`}>🌿 Normal — start here</a>
            <a class="route-pill route-pill--hard" href={`${base}${locale}/learn/python-101/hard/week-1`}>⚡ Hard — start here</a>
          </div>
        </div>
        <a class="sectioncard__all" href={`${base}${locale}/learn/python-101`}>See all 5 weeks →</a>
      </div>
      <div class="sectioncard">
        <div class="sectioncard__badge sectioncard__badge--streak">📊 Track 2</div>
        <div class="sectioncard__icon">📊</div>
        <h2>Pandas &amp; Data</h2>
        <p>Weeks 6–10. Ship a real notebook: pandas the way a data analyst actually uses it.</p>
        <div class="routes">
          <span class="routes__label">Choose your route:</span>
          <div class="routes__pills">
            <a class="route-pill route-pill--normal" href={`${base}${locale}/learn/data-analysis/normal/week-6`}>🌿 Normal — start here</a>
            <a class="route-pill route-pill--hard" href={`${base}${locale}/learn/data-analysis/hard/week-6`}>⚡ Hard — start here</a>
          </div>
        </div>
        <a class="sectioncard__all" href={`${base}${locale}/learn/data-analysis`}>See all 5 weeks →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 2.5rem 0 1.5rem; }
  .head__eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; display: inline-flex; align-items: center; gap: .3rem; }
  .head h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: .4rem 0 .2rem; }
  .head p { color: var(--ink-soft); }
  .sections { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin: 1.5rem 0 3rem; }
  .sectioncard {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem;
    box-shadow: var(--shadow-sm); transition: all var(--transition-smooth);
    position: relative; overflow: hidden;
  }
  .sectioncard:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .sectioncard__badge {
    display: inline-flex; align-items: center; gap: .25rem;
    padding: .2rem .6rem; border-radius: var(--radius-pill);
    font-size: .72rem; font-weight: 700; width: fit-content;
    background: var(--accent-soft); color: var(--accent);
  }
  .sectioncard__badge--streak { background: rgba(255,150,0,.1); color: var(--streak); }
  .sectioncard__icon { font-size: 2rem; }
  .sectioncard h2 { font-size: 1.2rem; margin: 0; }
  .sectioncard p { color: var(--ink-soft); font-size: .9rem; margin: 0; line-height: 1.5; }
  .routes { margin-top: auto; padding-top: .5rem; border-top: 1px solid var(--line); }
  .routes__label { display: block; font-size: .74rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
  .routes__pills { display: flex; gap: .7rem; flex-wrap: wrap; }
  .route-pill {
    display: inline-flex; align-items: center; gap: .4rem;
    text-decoration: none; padding: .6rem 1.1rem; border-radius: var(--radius-md);
    font-weight: 700; font-size: .85rem; color: #fff; border: none;
    box-shadow: var(--shadow-tactile); transition: transform .1s ease, box-shadow .1s ease;
  }
  .route-pill--normal { background: var(--success); box-shadow: 0 4px 0 #3d9401, 0 6px 16px rgba(88,204,2,.25); }
  .route-pill--normal:hover { filter: brightness(1.06); box-shadow: 0 4px 0 #3d9401, 0 8px 20px rgba(88,204,2,.35); }
  .route-pill--hard { background: var(--bad); box-shadow: 0 4px 0 #c81e3f, 0 6px 16px rgba(244,63,94,.25); }
  .route-pill--hard:hover { filter: brightness(1.06); box-shadow: 0 4px 0 #c81e3f, 0 8px 20px rgba(244,63,94,.35); }
  .sectioncard__all { align-self: flex-start; font-size: .82rem; font-weight: 700; color: var(--ink-soft); text-decoration: none; }
  .sectioncard__all:hover { color: var(--accent); }
  @media (max-width: 720px) { .sections { grid-template-columns: 1fr; } }
</style>

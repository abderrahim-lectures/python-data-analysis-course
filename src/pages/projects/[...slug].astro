---
// EN project detail: serves only English projects (Bug A fix — no more
// locale loop that let the last locale's content win on /projects/* URLs).
// Renders through the shared ProjectDetail component so the gamified
// step-clearing and mark-done wiring live in one place for all locales.
import {getCollection} from 'astro:content';
import ProjectDetail from '../../components/projects/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const paths = projects
    .filter((entry) => !/^(ar|es|fr)\//.test(entry.slug))
    .map((entry) => {
      // Some EN files keep a legacy `slug: /projects/<name>` frontmatter that
      // overrides entry.slug; normalize so the URL is /projects/<name>.
      const slug = entry.slug.replace(/^\/?projects\//, '');
      return {params: {slug}, props: {entry}};
    });
  return paths;
}

const {entry} = Astro.props;
---

<ProjectDetail entry={entry} locale="en" />
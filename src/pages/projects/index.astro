---
// EN project index — thin wrapper over the shared ProjectListing component.
import {getCollection} from 'astro:content';
import ProjectListing from '../../components/projects/ProjectListing.astro';

const projects = await getCollection('projects');

const filterStrings = {
  searchPlaceholder: 'Search all {n} projects…',
  searchAria: 'Search projects by title or description',
  filterTagAria: 'Filter by tag',
  tagAll: 'All',
  filterDiffAria: 'Filter by difficulty',
  diffAll: 'All Levels',
  diffBeginner: 'Beginner',
  diffIntermediate: 'Intermediate',
  diffAdvanced: 'Advanced',
  viewAria: 'View mode',
  viewListAria: 'List view',
  viewGridAria: 'Grid view',
  noMatchPrefix: 'No projects match',
  trySearch: 'Try a different search or tag.',
};
---

<ProjectListing locale="en" projects={projects} filterStrings={filterStrings} />
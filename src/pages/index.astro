---
import Base from '../layouts/Base.astro';
import {m} from '../paraglide/messages.js';
import Icon from '../components/Icon.astro';
import SceneBg from '../components/SceneBg.astro';
import PopularPages from '../components/PopularPages.astro';
import LearnerActivity from '../components/LearnerActivity.astro';

import {PROJECT_TAGS, projectArtEmoji} from '../lib/projectArt.ts';
import {learnHref, progressHref, playgroundHref, projectsHref} from '../lib/routeSegments';

const locale = 'en' as const;
const base = import.meta.env.BASE_URL;


const sampleTags = [...new Set(Object.values(PROJECT_TAGS).flat())].slice(0, 6);
const tagEmoji: Record<string, string> = {};
for (const t of sampleTags) tagEmoji[t] = projectArtEmoji([t]);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'PyDA Course',
  description: m.home_description(),
  provider: {
    '@type': 'Organization',
    name: 'PyDA Course',
    url: String(new URL(base, Astro.site)),
  },
  isAccessibleForFree: true,
  inLanguage: ['en', 'ar', 'es', 'fr'],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT10W',
  },
};
---

<Base title={m.home_title()} description={m.home_description()} lang={locale} dir="ltr" jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="hero__eyebrow">{m.home_eyebrow()}</span>
        <h1 class="hero__title">{m.home_h1()}</h1>
        <p class="hero__lead">{m.home_lead()}</p>

        <div class="player-card" id="player-card">
          <div class="player-card__left">
            <div class="player-card__avatar" id="player-avatar">🧑‍💻</div>
            <div class="player-card__info">
              <div class="player-card__rank" id="player-rank"><span class="badge badge--streak"></span></div>
              <div class="player-card__level">Lv.<span id="player-level">1</span></div>
            </div>
          </div>
          <div class="player-card__xp">
            <div class="player-card__xpbar" role="progressbar" aria-label={m.home_xp_aria_label()}>
              <div class="player-card__xpfill" id="player-xpfill" style="width:0%"></div>
            </div>
            <div class="player-card__xptext"><span id="player-xp">0</span> XP · <span id="player-xpnext">100</span> {m.home_xp_to_next()}</div>
          </div>
          <div class="player-card__actions">
            <a class="btn btn-xp btn-sm" href={learnHref(locale, base)}><Icon name="play" size={14} /> {m.home_quest_label()}</a>
            <a class="btn btn-streak btn-sm" href={progressHref(locale, base)}><Icon name="trophy" size={14} /> {m.home_profile_label()}</a>
          </div>
        </div>

        <div class="hero__actions">
          <a class="btn btn-primary btn-lg" href={playgroundHref(locale, base)}><Icon name="play" size={16} /> {m.home_hero_cta()}</a>
        </div>
        <div class="hero__features">
          <span class="hero__feature"><Icon name="play" size={14} /> {m.home_hero_feature_1()}</span>
          <span class="hero__feature"><Icon name="code" size={14} /> {m.home_hero_feature_2()}</span>
          <span class="hero__feature">{m.home_hero_feature_3()}</span>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <div class="hero__bracket">{m.home_terminal_bracket()}</div>
        <div class="hero__terminal">
          <div class="hero__termbar"><span></span><span></span><span></span></div>
          <div class="hero__termbody">
            <span class="t-soft">{m.home_terminal_line_1()}</span>
            <span class="t-prompt">&gt;&gt;&gt; </span><span class="t-code">{m.home_terminal_line_2()}</span>
            <span class="t-out">{m.home_terminal_line_3()}</span>
            <span class="t-soft">{m.home_terminal_line_4()}</span>
            <span class="t-soft">{m.home_terminal_line_5()}</span>
            <span class="t-soft">{m.home_terminal_line_6()}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="gamestrip">
      <div class="gamestrip__item" id="gs-xp">
        <span class="gamestrip__icon">⚡</span>
        <span class="gamestrip__val" id="gs-xp-val">0</span>
        <span class="gamestrip__label">{m.home_stat_xp()}</span>
      </div>
      <div class="gamestrip__item" id="gs-streak">
        <span class="gamestrip__icon">🔥</span>
        <span class="gamestrip__val" id="gs-streak-val">0</span>
        <span class="gamestrip__label">{m.home_stat_streak()}</span>
      </div>
      <div class="gamestrip__item" id="gs-badges">
        <span class="gamestrip__icon">🏅</span>
        <span class="gamestrip__val" id="gs-badges-val">0</span>
        <span class="gamestrip__label">{m.home_stat_badges()}</span>
      </div>
      <div class="gamestrip__item" id="gs-level">
        <span class="gamestrip__icon">⬆️</span>
        <span class="gamestrip__val" id="gs-level-val">1</span>
        <span class="gamestrip__label">{m.home_stat_level()}</span>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="rewards">
      <h2 class="rewards__title">{m.home_rewards_title()} <span class="text-gradient">{m.home_rewards_gradient()}</span></h2>
      <p class="rewards__sub">{m.home_rewards_sub()}</p>
      <div class="rewards__grid">
        <div class="reward">
          <div class="reward__icon">⚡</div>
          <h3>{m.home_reward_1_title()}</h3>
          <p>{m.home_reward_1_desc()}</p>
        </div>
        <div class="reward">
          <div class="reward__icon">🔥</div>
          <h3>{m.home_reward_2_title()}</h3>
          <p>{m.home_reward_2_desc()}</p>
        </div>
        <div class="reward">
          <div class="reward__icon">🏅</div>
          <h3>{m.home_reward_3_title()}</h3>
          <p>{m.home_reward_3_desc()}</p>
        </div>
        <div class="reward">
          <div class="reward__icon">👑</div>
          <h3>{m.home_reward_4_title()}</h3>
          <p>{m.home_reward_4_desc()}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="hub">
      <a class="hub__card" href={learnHref(locale, base, 'python-101')}>
        <SceneBg scene="forest" height={140} particles={false}>
          <span class="hub__icon">🐍</span>
        </SceneBg>
        <div class="hub__badge" style="color:var(--accent)">{m.home_hub_track_1()}</div>
        <div class="hub__inner">
          <div class="hub__meta">{m.home_hub_track_1_meta()}</div>
          <h2>{m.home_hub_track_1_name()}</h2>
          <p>{m.home_hub_track_1_desc()}</p>
          <div class="hub__progress"><div class="hub__progress-fill" id="hub-python" style="width:0%"></div></div>
          <span class="btn btn-primary hub__cta">{m.home_hub_track_1_cta()} <Icon name="play" size={14} /></span>
        </div>
      </a>
      <a class="hub__card" href={learnHref(locale, base, 'data-analysis')}>
        <SceneBg scene="city" height={140} particles={false}>
          <span class="hub__icon">📊</span>
        </SceneBg>
        <div class="hub__badge" style="color:var(--streak-text)">{m.home_hub_track_2()}</div>
        <div class="hub__inner">
          <div class="hub__meta">{m.home_hub_track_2_meta()}</div>
          <h2>{m.home_hub_track_2_name()}</h2>
          <p>{m.home_hub_track_2_desc()}</p>
          <div class="hub__progress"><div class="hub__progress-fill hub__progress-fill--streak" id="hub-data" style="width:0%"></div></div>
          <span class="btn btn-streak hub__cta">{m.home_hub_track_2_cta()} <Icon name="play" size={14} /></span>
        </div>
      </a>
      <a class="hub__card" href={projectsHref(locale, base)}>
        <SceneBg scene="library" height={140} particles={false}>
          <span class="hub__icon">🚀</span>
        </SceneBg>
        <div class="hub__badge" style="color:var(--warn)">{m.home_hub_projects()}</div>
        <div class="hub__inner">
          <div class="hub__meta">{m.home_hub_projects_meta()}</div>
          <h2>{m.home_hub_projects_name()}</h2>
          <p>{m.home_hub_projects_desc()}</p>
          <div class="hub__tags">
            {sampleTags.map((t) => <span class="chip">{tagEmoji[t] ?? ''} {t}</span>)}
          </div>
          <span class="btn btn-xp hub__cta">{m.home_hub_projects_cta()}</span>
        </div>
      </a>
    </div>
  </section>
  <PopularPages locale={locale} supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL || ''} supabaseKey={import.meta.env.PUBLIC_SUPABASE_KEY || ''} />
  <LearnerActivity locale={locale} supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL || ''} supabaseKey={import.meta.env.PUBLIC_SUPABASE_KEY || ''} />
</Base>

<script>
  import {renderHomepage} from '../lib/homeRender.ts';
  renderHomepage();
</script>


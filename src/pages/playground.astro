---
// Freeform Python playground, blank-start entry point (same Pyodide runtime,
// same .cell markup as the inline lesson cells so runnable-cell.client.ts
// hydrates it automatically). A lesson cell's ⛶ button links to
// /playground/<code> instead — see src/pages/404.astro for why that's a
// static-site 404 handler rather than a real dynamic route.
import Base from '../layouts/Base.astro';
import PlaygroundHead from '../components/PlaygroundHead.astro';
import PlaygroundCell from '../components/PlaygroundCell.astro';
import {PLAYGROUND_STARTER} from '../lib/playgroundStarter.ts';
---

<Base
  title="Playground — PyDA Course"
  description="A freeform, full-screen Python editor — run any code right in your browser, no install needed."
  lang="en"
  dir="ltr"
>
  <section class="container head">
    <PlaygroundHead
      eyebrow="Full-screen editor"
      lead="Write and run any Python here — nothing is graded, nothing is saved when you leave."
    />
  </section>

  <section class="container playground-page">
    <PlaygroundCell starter={PLAYGROUND_STARTER} />
  </section>
</Base>

<script define:vars={{STARTER: PLAYGROUND_STARTER}}>
  document.getElementById('pg-reset')?.addEventListener('click', () => {
    const codeEl = document.getElementById('pg-code');
    codeEl.textContent = STARTER;
    codeEl.dispatchEvent(new Event('input', {bubbles: true}));
  });
</script>

<style>
  .head { padding: 2.5rem 0 1rem; }
</style>

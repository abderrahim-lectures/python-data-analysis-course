---
// Freeform Python playground — a bigger, standalone version of the inline
// lesson code cells (same Pyodide runtime, same .cell markup so the shared
// runnable-cell.client.ts hydrates it automatically). Reached either
// directly or via a lesson cell's ⛶ "open in full-screen editor" button,
// which hands off the cell's current code via a `?code=` query param.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const STARTER = `# Playground — write and run any Python here.
# Nothing is graded here; it's just a bigger scratch space.

def greet(name):
    return f"Hello, {name}!"

print(greet("world"))
`;
---

<Base
  title="Playground — PyDA Course"
  description="A freeform, full-screen Python editor — run any code right in your browser, no install needed."
  lang="en"
  dir="ltr"
>
  <section class="container head">
    <div class="head__eyebrow"><Icon name="expand" size={16} /> Full-screen editor</div>
    <h1>Playground</h1>
    <p>Write and run any Python here — nothing is graded, nothing is saved when you leave. Came from a lesson's ⛶ button? Your code came with you.</p>
  </section>

  <section class="container playground-page">
    <div class="pg-warn" id="pg-warn" hidden>
      <strong>⚠️ This code came from a link.</strong>
      <p>Someone else may have written it. Read it before you run it — code here runs in your browser with access to this site's data.</p>
      <button class="btn btn-primary btn-sm" id="pg-trust">I've read it — let me run it</button>
      <button class="btn btn-ghost btn-sm" id="pg-discard">Discard it</button>
    </div>
    <div class="cell cell--big" data-runnable>
      <div class="cell__actions">
        <button class="btn btn-primary cell__run" data-run aria-label="Run this Python code">▶ Run</button>
        <button class="btn btn-ghost btn-sm" id="pg-reset">Reset</button>
        <span class="cell__lang">python</span>
      </div>
      <pre class="cell__code"><code id="pg-code">{STARTER}</code></pre>
      <div class="cell__output" data-output hidden>
        <div class="cell__lines" data-lines></div>
        <button class="cell__clear" data-clear hidden>Clear</button>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{STARTER}}>
  const MAX_SHARED_CODE = 20000;
  const codeEl = document.getElementById('pg-code');
  const cell = document.querySelector('.cell[data-runnable]');
  const warn = document.getElementById('pg-warn');
  const runBtn = cell?.querySelector('[data-run]');

  const setStarter = () => {
    codeEl.textContent = STARTER;
    cell?.removeAttribute('data-untrusted');
    warn.hidden = true;
    if (runBtn) runBtn.disabled = false;
  };

  const shared = new URLSearchParams(location.search).get('code');
  // The lesson page's own ⛶ button lands here the same way an externally
  // shared link would (?code=...), and the two are indistinguishable from the
  // URL alone. document.referrer tells them apart: our own ⛶ button navigates
  // same-origin, so a same-origin referrer means this is in-app, not a link
  // someone sent. An empty or cross-origin referrer is the real untrusted case.
  const fromThisSite = document.referrer && new URL(document.referrer).origin === location.origin;
  if (shared && shared.length <= MAX_SHARED_CODE) {
    codeEl.textContent = shared;
    if (fromThisSite) {
      cell?.removeAttribute('data-untrusted');
      warn.hidden = true;
      if (runBtn) runBtn.disabled = false;
    } else {
      // Anyone can craft a ?code= link, so treat it as untrusted until the
      // learner has actually looked at it: Pyodide can reach this origin's
      // localStorage and fetch through the `js` bridge.
      cell?.setAttribute('data-untrusted', '1');
      warn.hidden = false;
      if (runBtn) runBtn.disabled = true;
    }
  }

  document.getElementById('pg-trust')?.addEventListener('click', () => {
    cell?.removeAttribute('data-untrusted');
    warn.hidden = true;
    if (runBtn) runBtn.disabled = false;
  });
  document.getElementById('pg-discard')?.addEventListener('click', setStarter);
  document.getElementById('pg-reset')?.addEventListener('click', setStarter);
</script>

<style>
  .head { padding: 2.5rem 0 1rem; }
  .head__eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; display: inline-flex; align-items: center; gap: .3rem; }
  .head h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: .4rem 0 .2rem; }
  .head p { color: var(--ink-soft); max-width: 60ch; }
  .playground-page { padding-bottom: 3rem; }
  .pg-warn { border: 2px solid var(--streak); background: var(--warn-soft); color: var(--ink); border-radius: var(--radius-md); padding: .9rem 1.1rem; margin-bottom: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .pg-warn strong { flex-basis: 100%; color: var(--ink-hi); }
  .pg-warn p { flex: 1 1 22ch; margin: 0; color: var(--ink); font-size: .88rem; }
  .playground-page :global(.cell--big .cell__code) { min-height: 50vh; font-size: 1rem; }
  .playground-page :global(.cell--big .cell__output) { max-height: 30vh; overflow-y: auto; }
  /* Run/Reset/python cram into one line on narrow viewports; let them wrap. */
  .playground-page :global(.cell__actions) { flex-wrap: wrap; }
  .playground-page :global(.cell__actions .btn) { white-space: nowrap; }
</style>

---
// EN lesson template: /learn/[section]/[track]/lessons/[lesson].
// Thin wrapper, all markup lives in the shared LessonPage component.
import {getCollection} from 'astro:content';
import LessonPage from '../../../../../components/learn/LessonPage.astro';
import {idInLocale} from '../../../../../lib/routeSegments';
const locale = 'en' as const;

export async function getStaticPaths() {
  const locale = 'en' as const;
  const entries = await getCollection('lessons');
  return entries
    .filter((e) => idInLocale(locale, e.id))
    .map((entry) => {
      const [section, track] = entry.id.split('/') as [string, 'normal' | 'hard'];
      return {
        params: {section, track, lesson: entry.id.split('/').pop()!},
        props: {section, track, entry},
      };
    });
}
---
<LessonPage locale={locale} section={Astro.props.section} track={Astro.props.track} entry={Astro.props.entry} />
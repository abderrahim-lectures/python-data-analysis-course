---
// Dynamic lesson route: renders every markdown lesson in the `learn` content
// collection under /learn/<section>/<track>/week-<n>. Replaces the hand-written
// proof-of-concept page (which stays as a redirect target via the same slug).
import {getCollection, type CollectionEntry} from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import {PAGE_STRINGS} from '../../../../lib/pageStrings';
import {detectLocale, TRACK_WORDS} from '../../../../lib/routeSegments';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  return entries
    .filter((e) => !/^(ar|es|fr)\//.test(e.slug) && e.data.track && e.data.week)
    .map((entry) => {
      const parts = entry.slug.split('/');
      const week = parts[parts.length - 1];
      const track = parts[parts.length - 2];
      const section = entry.data.section!;
      return {
        params: {section, track, week},
        props: {entry},
      };
    });
}

const {entry} = Astro.props;
const {title, description, week, track, section} = entry.data;
const {Content} = await entry.render();
const base = import.meta.env.BASE_URL;
const locale = detectLocale(Astro.url.pathname);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const t = TRACK_WORDS[locale];
const ps = PAGE_STRINGS[locale];
const lessonId = `${section}/${track}/week-${week}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: title,
  description,
  learningResourceType: 'Lesson',
  educationalLevel: track === 'hard' ? 'Advanced' : 'Beginner',
  isAccessibleForFree: true,
  inLanguage: locale,
  url: String(new URL(`${base}learn/${section}/${track}/${week}`, Astro.site)),
  position: week,
  isPartOf: {
    '@type': 'Course',
    name: 'PyDA Course',
    description: ps.courseDescription,
  },
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} jsonLd={jsonLd}>
  <nav class="crumb container">
    <a href={`${base}learn`}>Learn</a> <span>/</span>
    <a href={`${base}learn/${section}`}>{section}</a> <span>/</span>
    <span class="crumb__here">Week {week}</span>
  </nav>

  <article class="container lesson-body" data-lesson-id={lessonId}>
    <header class="lesson-head">
      <span class="lesson-head__week">{section} · {track === 'normal' ? 'Normal' : 'Hard'} Track</span>
      <h1>{title}</h1>
      {description && <p class="lesson-head__sub">{description}</p>}
    </header>

    <div class="lesson-content">
      <Content />
    </div>

    <div class="lesson-nav">
      {prev
        ? <a class="lesson-nav__prev" href={`${base}learn/${section}/${track}/week-${prev.data.week}`}>← Week {prev.data.week}</a>
        : <span />}
      {next
        ? <a class="lesson-nav__next" href={`${base}learn/${section}/${track}/week-${next.data.week}`}>Week {next.data.week} →</a>
        : <span />}
      <button class="btn btn-soft lesson-nav__done" data-mark-complete
        data-label-done={ps.completed}>{ps.markComplete}</button>
    </div>

    <div class="route">
      <a class="route__card" href={`${base}learn/${section}/${otherTrack}/week-${week}`}>
        <span class="route__icon">{otherTrack === 'hard' ? '⚡' : '🌿'}</span>
        <strong>{ps.switchTo} {otherTrack === 'hard' ? ps.trackHardLabel : ps.trackNormalLabel}</strong>
        <small>{otherTrack === 'hard' ? ps.sameWeekSteep : ps.sameWeekCalm}</small>
      </a>
    </div>
  </article>
</Base>

<script>
  import {completeLesson, isLessonComplete} from '../../../../lib/gameState';
  const article = document.querySelector('[data-lesson-id]');
  const id = article?.getAttribute('data-lesson-id');
  const btn = document.querySelector('[data-mark-complete]') as HTMLButtonElement | null;

  const markDone = () => {
    if (!btn) return;
    btn.textContent = btn.dataset.labelDone ?? 'Completed';
    btn.classList.add('is-done');
    btn.disabled = true;
  };

  if (id && isLessonComplete(id)) markDone();

  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!id) return;
    completeLesson(id);
    markDone();
    document.dispatchEvent(new CustomEvent('lesson:complete'));
  });
</script>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .lesson-head { margin: 1.5rem 0 1rem; }
  .lesson-head__week { color: var(--accent); font-weight: 800; letter-spacing: .04em; text-transform: uppercase; font-size: .8rem; }
  .lesson-head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .3rem 0; }
  .lesson-head__sub { color: var(--ink-soft); font-size: 1.05rem; }
  .lesson-head h1 { text-wrap: balance; }
  .lesson-content :global(h2) { margin-top: 2.2rem; }
  .lesson-content :global(.gamified-flourish) { display: block; background: var(--accent-soft); color: var(--accent-text); border-radius: var(--radius-md); padding: .8rem 1rem; margin: 1rem 0; font-weight: 600; }
  .lesson-nav { display: flex; justify-content: space-between; align-items: center; margin: 2rem 0; gap: 1rem; }
  .lesson-nav a {
    text-decoration: none; font-weight: 700; padding: .6rem 1.1rem; min-height: 40px;
    border-radius: var(--radius-pill); background: var(--surface); border: 1px solid var(--line);
    color: var(--ink); box-shadow: var(--shadow-sm); display: inline-flex; align-items: center;
    transition: transform .1s ease, box-shadow .1s ease, border-color .15s ease, color .15s ease;
  }
  .lesson-nav a:hover { transform: translateY(-1px); border-color: var(--accent); color: var(--accent); box-shadow: var(--shadow-md); }
  .lesson-nav a:active { transform: translateY(1px); box-shadow: var(--shadow-sm); }
  .lesson-nav .btn { white-space: nowrap; }
  /* Completed state: same tactile language as every other button, not a flat
     green slab. A soft success fill + success-deep bottom shadow reads as a
     fired control, and the check marks the win. */
  .lesson-nav__done { transition: transform .1s ease, box-shadow .1s ease, background .15s ease, color .15s ease; }
  .lesson-nav__done.is-done {
    background: var(--success-soft); color: #2e8b0b;
    box-shadow: inset 0 0 0 2px rgba(88, 204, 2, .35), var(--shadow-sm);
  }
  [data-theme='dark'] .lesson-nav__done.is-done { color: #6ce07f; }
  .lesson-nav__done.is-done::before { content: '✓ '; font-weight: 900; }
  .route { display: grid; margin: 1.5rem 0 3rem; }
  .route__card {
    background: var(--accent-soft); border: 1px solid rgba(124,58,237,.22);
    border-inline-start: 4px solid var(--accent); border-radius: var(--radius-lg);
    padding: 1.2rem; text-decoration: none; color: var(--ink);
    display: flex; flex-direction: column; gap: .3rem; box-shadow: var(--shadow-sm);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .route__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .route__card strong { color: var(--accent-text); }
  .route__card small { color: var(--ink-soft); }
  .route__icon { font-size: 1.6rem; }
</style>

---
// EN section landing: /learn/[section]. Thin wrapper — all markup lives in SectionLanding.
import {getCollection} from 'astro:content';
import SectionLanding from '../../../components/learn/SectionLanding.astro';
import {idInLocale} from '../../../lib/routeSegments';
const locale = 'en' as const;

export async function getStaticPaths() {
  const locale = 'en' as const;
  const modules = await getCollection('modules');
  const sections = [...new Set(
    modules
      .filter((m) => idInLocale(locale, m.id))
      .map((m) => m.id.split('/')[0]),
  )].sort();
  return sections.map((section) => ({params: {section}, props: {section}}));
}
---
<SectionLanding locale={locale} section={Astro.props.section} />
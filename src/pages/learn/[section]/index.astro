---
// Section landing page: /learn/python-101, /learn/data-analysis.
// Uses the section's own index.md (data-analysis/data-analysis/index.md etc.)
// for title/description, and lists the weeks available per track.
import {getCollection} from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  const sections = new Map<string, typeof entries>();
  for (const e of entries) {
    if (!e.data.section || /^(ar|es|fr)\//.test(e.slug)) continue;
    const list = sections.get(e.data.section) ?? [];
    list.push(e);
    sections.set(e.data.section, list);
  }
  return [...sections.entries()].map(([section, lessons]) => ({
    params: {section},
    props: {section, lessons},
  }));
}

interface Props { section: string; lessons: Awaited<ReturnType<typeof getCollection<'learn'>>> }
const {section, lessons} = Astro.props;
const base = import.meta.env.BASE_URL;

// Astro strips a trailing `/index` from content slugs, so matching on
// `.../index` never hit and every section page silently fell back to the
// English `"<slug> lessons."` placeholder with a raw-slug title.
// Astro strips a trailing `/index` from content slugs and, for a nested
// `<section>/<section>/index.md`, emits a leading slash — so the original
// `.endsWith('<section>/index')` match never hit and every section page
// silently fell back to the English `"<slug> lessons."` placeholder.
const indexEntry = (await getCollection('learn')).find((e) => {
  if (/^(ar|es|fr)\//.test(e.slug)) return false;
  const norm = e.slug.replace(/^\//, '').replace(/\/index$/, '');
  return norm === section || norm === `${section}/${section}`;
});
const title = indexEntry?.data.title ?? section;
const description = indexEntry?.data.description ?? `${section} lessons.`;

const byTrack = (track: 'normal' | 'hard') =>
  lessons
    .filter((e) => e.data.track === track && typeof e.data.week === 'number')
    .sort((a, b) => (a.data.week ?? 0) - (b.data.week ?? 0));
const normalWeeks = byTrack('normal');
const hardWeeks = byTrack('hard');
---

<Base title={`${title} — PyDA Course`} description={description} lang="en" dir="ltr">
  <nav class="crumb container">
    <a href={`${base}learn`}>Learn</a> <span>/</span> <span class="crumb__here">{title}</span>
  </nav>

  <section class="container head">
    <h1>{title}</h1>
    <p>{description}</p>
  </section>

  <section class="container tracks">
    <div class="track">
      <h2>🌿 Normal track</h2>
      <div class="weeks">
        {normalWeeks.map((w) => (
          <a class="week" href={`${base}learn/${section}/normal/week-${w.data.week}`}>
            <span class="week__num">Week {w.data.week}</span>
            <span class="week__title">{w.data.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="track">
      <h2>⚡ Hard track</h2>
      <div class="weeks">
        {hardWeeks.map((w) => (
          <a class="week" href={`${base}learn/${section}/hard/week-${w.data.week}`}>
            <span class="week__num">Week {w.data.week}</span>
            <span class="week__title">{w.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .head { padding: 1.5rem 0; }
  .head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .3rem 0; }
  .head p { color: var(--ink-soft); }
  .tracks { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 3rem; }
  .track h2 { font-size: 1.1rem; margin-bottom: .8rem; }
  .weeks { display: flex; flex-direction: column; gap: .6rem; }
  .week {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: .8rem 1rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column;
    box-shadow: var(--shadow-sm); transition: all var(--transition-smooth);
  }
  .week:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .week__num { color: var(--accent); font-weight: 700; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .week__title { font-weight: 600; }
  @media (max-width: 640px) { .tracks { grid-template-columns: 1fr; } }
</style>

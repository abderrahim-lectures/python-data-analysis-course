---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {PAGE_STRINGS} from '../../lib/pageStrings';
const base = import.meta.env.BASE_URL;
const s = PAGE_STRINGS.en;
---

<Base title={s.learnHubTitle} description={s.learnHubDescription} lang="en" dir="ltr">
  <section class="hero">
    <div class="container head">
      <div class="head__eyebrow"><Icon name="code" size={16} /> {s.learnHubEyebrow}</div>
      <h1>{s.learnHubH1}</h1>
      <p>{s.learnHubLead}</p>
    </div>
  </section>

  <section class="container">
    <div class="note">
      A <strong>trail</strong> is your path through the course. Each week is a station — finish it to light it up and earn <span class="text-gradient">+20 XP</span>.
      You can switch routes at any time. Keep your streak alive for bonus XP.
    </div>
  </section>

  <section class="container">
    <div class="sections">
      <div class="sectioncard">
        <div class="sectioncard__badge">🐍 {s.track1}</div>
        <div class="sectioncard__icon">🐍</div>
        <h2>{s.track1Name}</h2>
        <p>{s.track1Desc}</p>
        <div class="sectioncard__meta">
          <span class="badge badge--xp">⚡ 100 XP</span>
          <span class="badge badge--streak">🔥 5 weeks</span>
        </div>
        <div class="routes">
          <span class="routes__label">{s.chooseRoute}</span>
          <div class="routes__pills">
            <a class="route-pill route-pill--normal" href={`${base}learn/python-101/normal/week-1`}>🌿 {s.normalStart}</a>
            <a class="route-pill route-pill--hard" href={`${base}learn/python-101/hard/week-1`}>⚡ {s.hardStart}</a>
          </div>
        </div>
        <a class="sectioncard__all" href={`${base}learn/python-101`}>{s.seeAllWeeks}</a>
      </div>
      <div class="sectioncard">
        <div class="sectioncard__badge sectioncard__badge--streak">📊 {s.track2}</div>
        <div class="sectioncard__icon">📊</div>
        <h2>{s.track2Name}</h2>
        <p>{s.track2Desc}</p>
        <div class="sectioncard__meta">
          <span class="badge badge--xp">⚡ 100 XP</span>
          <span class="badge badge--streak">🔥 5 weeks</span>
        </div>
        <div class="routes">
          <span class="routes__label">{s.chooseRoute}</span>
          <div class="routes__pills">
            <a class="route-pill route-pill--normal" href={`${base}learn/data-analysis/normal/week-6`}>🌿 {s.normalStart}</a>
            <a class="route-pill route-pill--hard" href={`${base}learn/data-analysis/hard/week-6`}>⚡ {s.hardStart}</a>
          </div>
        </div>
        <a class="sectioncard__all" href={`${base}learn/data-analysis`}>{s.seeAllWeeks}</a>
      </div>
    </div>

    <!-- Rewards preview -->
    <div class="rewards-preview">
      <h3>What you'll earn <span class="text-gradient">along the way</span></h3>
      <div class="rewards-preview__grid">
        <div class="rpv">
          <span class="rpv__icon">⚡</span>
          <span class="rpv__val">+20</span>
          <span class="rpv__label">XP per lesson</span>
        </div>
        <div class="rpv">
          <span class="rpv__icon">🔥</span>
          <span class="rpv__val">+5</span>
          <span class="rpv__label">streak bonus</span>
        </div>
        <div class="rpv">
          <span class="rpv__icon">🏅</span>
          <span class="rpv__val">11</span>
          <span class="rpv__label">badges</span>
        </div>
        <div class="rpv">
          <span class="rpv__icon">👑</span>
          <span class="rpv__val">7</span>
          <span class="rpv__label">rank tiers</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 2.5rem 0 1.5rem; }
  .head__eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; display: inline-flex; align-items: center; gap: .3rem; }
  .head h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: .4rem 0 .2rem; }
  .head p { color: var(--ink-soft); }

  .sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 1.25rem; margin: 1.5rem 0 2rem; }
  .sectioncard {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem;
    box-shadow: var(--shadow-sm); transition: all var(--transition-smooth);
    position: relative; overflow: hidden;
  }
  .sectioncard:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .sectioncard__badge {
    display: inline-flex; align-items: center; gap: .25rem;
    padding: .2rem .6rem; border-radius: var(--radius-pill);
    font-size: .72rem; font-weight: 700; width: fit-content;
    background: var(--accent-soft); color: var(--accent);
  }
  .sectioncard__badge--streak { background: rgba(255,150,0,.1); color: var(--streak); }
  .sectioncard__icon { font-size: 2rem; }
  .sectioncard h2 { font-size: 1.2rem; margin: 0; }
  .sectioncard p { color: var(--ink-soft); font-size: .9rem; margin: 0; line-height: 1.5; }
  .sectioncard__meta { display: flex; gap: .5rem; flex-wrap: wrap; }
  /* Route pills are the card's one primary action (pick a track and jump
     straight into week 1); "See all N weeks" below is a clearly separate,
     secondary text link — kept apart so the two don't read as the same click. */
  .routes { margin-top: auto; padding-top: .5rem; border-top: 1px solid var(--line); }
  .routes__label { display: block; font-size: .74rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
  .routes__pills { display: flex; gap: .7rem; flex-wrap: wrap; }
  .route-pill {
    display: inline-flex; align-items: center; gap: .4rem;
    text-decoration: none; padding: .6rem 1.1rem; border-radius: var(--radius-md);
    font-weight: 700; font-size: .85rem; color: #fff; border: none;
    box-shadow: var(--shadow-tactile); transition: transform .1s ease, box-shadow .1s ease;
  }
  .route-pill:active { transform: translateY(3px); box-shadow: 0 1px 0 rgba(0,0,0,.08), 0 2px 8px rgba(16,24,40,.06); }
  .route-pill--normal { background: var(--success); box-shadow: 0 4px 0 #3d9401, 0 6px 16px rgba(88,204,2,.25); }
  .route-pill--normal:hover, .route-pill--hard:hover { transform: translateY(-1px); }
  .route-pill--normal:hover { filter: brightness(1.06); box-shadow: 0 4px 0 #3d9401, 0 8px 20px rgba(88,204,2,.35); }
  .route-pill--normal:active { box-shadow: 0 1px 0 #3d9401, 0 2px 8px rgba(88,204,2,.15); }
  .route-pill--hard { background: var(--bad); box-shadow: 0 4px 0 #c81e3f, 0 6px 16px rgba(244,63,94,.25); }
  .route-pill--hard:hover { filter: brightness(1.06); box-shadow: 0 4px 0 #c81e3f, 0 8px 20px rgba(244,63,94,.35); }
  .route-pill--hard:active { box-shadow: 0 1px 0 #c81e3f, 0 2px 8px rgba(244,63,94,.15); }
  .sectioncard__all { align-self: flex-start; font-size: .82rem; font-weight: 700; color: var(--ink-soft); text-decoration: none; }
  .sectioncard__all:hover { color: var(--accent); }

  .rewards-preview { padding: 1.5rem 0 2rem; }
  .rewards-preview h3 { font-size: 1.2rem; margin-bottom: .75rem; }
  .rewards-preview__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
  .rpv {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 1rem; text-align: center; box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; align-items: center; gap: .2rem;
    transition: all var(--transition-smooth);
  }
  .rpv:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .rpv__icon { font-size: 1.25rem; }
  .rpv__val { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; color: var(--ink-hi); }
  .rpv__label { font-size: .72rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .03em; }

  @media (max-width: 720px) { .sections { grid-template-columns: 1fr; } .rewards-preview__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
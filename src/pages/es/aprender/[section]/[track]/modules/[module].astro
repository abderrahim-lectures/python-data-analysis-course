---
// Module template: /es/aprender/[section]/[track]/modules/[module].
// Thin wrapper — all markup lives in the shared ModulePage component.
import {getCollection} from 'astro:content';
import ModulePage from '../../../../../../components/learn/ModulePage.astro';
const locale = 'es' as const;

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules
    .filter((m) => m.slug.includes('/'))
    .map((m) => {
      const [section, track] = m.slug.split('/') as [string, 'normal' | 'hard'];
      return {
        params: {section, track, module: m.slug.split('/').pop()!},
        props: {section, track, entry: m},
      };
    });
}
---
<ModulePage locale={locale} section={Astro.props.section} track={Astro.props.track} entry={Astro.props.entry} />
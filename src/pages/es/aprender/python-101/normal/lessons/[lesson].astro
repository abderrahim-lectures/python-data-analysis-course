---
import {getCollection} from 'astro:content';
import Base from '../../../../../../layouts/Base.astro';
import InteractiveChallenge from '../../../../../../components/InteractiveChallenge.astro';
import {PAGE_STRINGS} from '../../../../../../lib/pageStrings';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries
    .filter((e) => e.slug.includes('python-101/normal'))
    .map((entry) => ({
      params: {lesson: entry.slug.split('/').pop()!},
      props: {entry},
    }));
}

const {entry} = Astro.props;
const {title, description, module: moduleId, order, difficulty, estimatedMinutes, learningObjectives, prerequisites, tags, hasPlayground, hasChallenge, hasQuiz, xpReward} = entry.data;
const {Content} = await entry.render();
const base = import.meta.env.BASE_URL;
const locale = 'es' as const;
const dir = 'ltr' as const;
const ps = PAGE_STRINGS[locale];

const allLessons = await getCollection('lessons');
const siblings = allLessons.filter((e) => e.slug.includes('python-101/normal')).sort((a, b) => a.data.order - b.data.order);
const allModules = await getCollection('modules');
const sortedModules = allModules.filter((e) => e.slug.includes('python-101/normal')).sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((e) => e.slug === entry.slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

const lessonId = 'python-101/normal/${entry.slug.split('/').pop()}';
const slug = entry.slug.split('/').pop()!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: title,
  description,
  learningResourceType: 'Lesson',
  educationalLevel: difficulty,
  isAccessibleForFree: true,
  inLanguage: locale,
  url: String(new URL(`${base}es/aprender/python-101/normal/lessons/${slug}`, Astro.site)),
  position: order,
  timeRequired: `PT${estimatedMinutes}M`,
  isPartOf: {
    '@type': 'Course',
    name: 'PyDA Course',
    description: ps.courseDescription,
  },
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} jsonLd={jsonLd}>
  <nav class="crumb container">
    <a href={`${base}learn`}>Learn</a> <span>/</span>
    <a href={`${base}learn/SECTION`}>Python 101</a> <span>/</span>
    <a href={`${base}learn/python-101/normal`}>Normal</a> <span>/</span>
    {(() => { const m = sortedModules.find(m => m.slug.split('/').pop()!.replace(/^module-\d+-/, '') === moduleId); return m ? <a href={`${base}learn/python-101/normal/modules/${m.slug.split('/').pop()}`}>{m.data.title}</a> : <span>{moduleId}</span>; })()} <span>/</span>
    <span class="crumb__here">{title}</span>
  </nav>

  <article class="container lesson-body" data-lesson-id={lessonId}>
    <header class="lesson-head">
      <span class="lesson-head__tag">📖 Lección {order}</span>
      <h1>{title}</h1>
      {description && <p class="lesson-head__sub">{description}</p>}
      <div class="lesson-head__meta">
        <span>⏱ {estimatedMinutes} min</span>
        <span>⚡ +{xpReward} XP</span>
        {tags?.length > 0 && <span class="tags">{tags.join(' · ')}</span>}
      </div>
    </header>

    {learningObjectives && learningObjectives.length > 0 && (
      <div class="objectives">
        <h3>🎯 {ps.objectives}</h3>
        <ul>{learningObjectives.map((o: string) => <li>{o}</li>)}</ul>
      </div>
    )}

    <div class="lesson-content"><Content /></div>

    {hasChallenge && (
      <InteractiveChallenge
        code={`# Write your code here\nprint("Hello, World!")`}
        expected="Hello, World!"
      />
    )}

    <div class="lesson-nav">
      {prev ? <a class="btn btn-soft" href={`${base}learn/python-101/normal/lessons/${prev.slug.split('/').pop()}`}>← {ps.prevLesson}</a> : <span />}
      {next ? <a class="btn btn-primary" href={`${base}learn/python-101/normal/lessons/${next.slug.split('/').pop()}`}>{ps.nextLesson} →</a> : <span />}
      <button class="btn btn-soft lesson-nav__done" data-mark-complete data-label-done={ps.completed}>{ps.markComplete}</button>
    </div>
  </article>
</Base>

<script>
  import {completeLesson, isLessonComplete} from '../../../../../../lib/gameState';
  const article = document.querySelector('[data-lesson-id]');
  const id = article?.getAttribute('data-lesson-id');
  const btn = document.querySelector('[data-mark-complete]') as HTMLButtonElement | null;

  const markDone = () => {
    if (!btn) return;
    btn.textContent = btn.dataset.labelDone ?? 'Completed';
    btn.classList.add('is-done');
    btn.disabled = true;
  };

  if (id && isLessonComplete(id)) markDone();

  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!id) return;
    completeLesson(id);
    markDone();
    document.dispatchEvent(new CustomEvent('lesson:complete'));
  });
</script>

<style>
  .crumb { display: flex; gap: .5rem; padding-top: 1.2rem; color: var(--ink-soft); font-size: .88rem; align-items: center; flex-wrap: wrap; }
  .crumb a { color: var(--ink-soft); text-decoration: none; }
  .crumb__here { font-weight: 700; color: var(--ink); }
  .lesson-head { margin: 1.5rem 0 1rem; }
  .lesson-head__tag { color: var(--accent); font-weight: 800; letter-spacing: .04em; text-transform: uppercase; font-size: .8rem; }
  .lesson-head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .3rem 0; }
  .lesson-head__sub { color: var(--ink-soft); font-size: 1.05rem; }
  .lesson-head__meta { display: flex; gap: .75rem; margin-top: .5rem; font-size: .85rem; color: var(--ink-soft); flex-wrap: wrap; }
  .tags { font-style: italic; }
  .objectives { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .objectives h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .objectives ul { margin: 0; padding-left: 1.2rem; }
  .objectives li { margin: .25rem 0; font-size: .92rem; color: var(--ink-soft); }
  .lesson-content :global(h2) { margin-top: 2.2rem; }
  .lesson-content :global(.gamified-flourish) { display: block; background: var(--accent-soft); color: var(--accent-text); border-radius: var(--radius-md); padding: .8rem 1rem; margin: 1rem 0; font-weight: 600; }
  .lesson-nav { display: flex; justify-content: space-between; align-items: center; margin: 2rem 0; gap: 1rem; flex-wrap: wrap; }
  .lesson-nav a { text-decoration: none; font-weight: 700; padding: .6rem 1.1rem; border-radius: var(--radius-pill); background: var(--surface); border: 1px solid var(--line); color: var(--ink); box-shadow: var(--shadow-sm); }
</style>

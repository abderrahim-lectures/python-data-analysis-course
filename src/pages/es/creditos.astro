---
// Credits page — ported from the Docusaurus-era src/pages/credits.tsx that was
// dropped in the Astro migration, leaving 8 lesson pages linking to a 404.
import Base from '../../layouts/Base.astro';
import {m} from '../../paraglide/messages';
import {NAV_WORDS} from '../../lib/routeSegments';

const locale = 'es' as const;
const entries = [
  {href: 'https://pyodide.org', name: m.credits_entry_1_name(), note: m.credits_entry_1_note()},
  {href: 'https://www.kaggle.com/c/titanic', name: m.credits_entry_2_name(), note: m.credits_entry_2_note()},
  {href: 'https://www.kaggle.com/datasets/spscientist/students-performance-in-exams', name: m.credits_entry_3_name(), note: m.credits_entry_3_note()},
];
const alternates = {
  en: NAV_WORDS.en.credits,
  ar: `ar/${NAV_WORDS.ar.credits}`,
  es: `es/${NAV_WORDS.es.credits}`,
  fr: `fr/${NAV_WORDS.fr.credits}`,
};
---

<Base title={m.credits_title()} description={m.credits_description()} lang={locale} dir="ltr" alternates={alternates}>
  <section class="container credits">
    <h1>{m.credits_heading()}</h1>
    <p class="credits__intro">{m.credits_intro()}</p>
    <ul class="credits__list">
      {entries.map((e) => (
        <li class="credits__item">
          <a href={e.href} target="_blank" rel="noopener noreferrer">{e.name}</a>
          <span class="credits__note">{e.note}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .credits { padding: 2.5rem 0 3rem; max-width: 70ch; }
  .credits h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 .4rem; }
  .credits__intro { color: var(--ink-soft); margin: 0 0 1.5rem; }
  .credits__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .credits__item {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius-lg); padding: 1rem 1.15rem;
    box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: .3rem;
  }
  .credits__item a { font-weight: 700; color: var(--accent); text-decoration: none; width: fit-content; }
  .credits__item a:hover { text-decoration: underline; }
  .credits__note { color: var(--ink-soft); font-size: .9rem; line-height: 1.55; }
</style>

---
// ES project index — thin wrapper over the shared ProjectListing component.
import {getCollection} from 'astro:content';
import ProjectListing from '../../../components/projects/ProjectListing.astro';

const projects = await getCollection('projects');

const filterStrings = {
  searchPlaceholder: 'Buscar {n} proyectos…',
  searchAria: 'Buscar proyectos por título o descripción',
  filterTagAria: 'Filter by tag',
  tagAll: 'Todos',
  filterDiffAria: 'Filter by difficulty',
  diffAll: 'Todos los niveles',
  diffBeginner: 'Principiante',
  diffIntermediate: 'Intermedio',
  diffAdvanced: 'Avanzado',
  viewAria: 'View mode',
  viewListAria: 'List view',
  viewGridAria: 'Grid view',
  noMatchPrefix: 'No hay proyectos que coincidan con',
  trySearch: 'Prueba con otra búsqueda o etiqueta.',
};
---

<ProjectListing locale="es" projects={projects} filterStrings={filterStrings} />
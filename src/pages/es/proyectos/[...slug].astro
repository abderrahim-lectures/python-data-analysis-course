---
import {getCollection, type CollectionEntry} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectArt from '../../../components/ProjectArt.astro';
import {detectLocale, projectsHref, type Locale} from '../../../lib/routeSegments';
import {PAGE_STRINGS} from '../../../lib/pageStrings';
import '../../../styles/project-detail.css';

const locale = detectLocale(Astro.url.pathname);

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.slug.split('/')[0] === 'es')
    .map((entry) => {
      const slug = entry.slug.slice('es'.length + 1);
      return {params: {slug}, props: {entry}};
    });
}

const {entry} = Astro.props;
const {title, description} = entry.data;
const {Content} = await entry.render();
const base = import.meta.env.BASE_URL;
const dir = 'ltr' as const;
const slug = entry.slug.slice('es'.length + 1);
const ps = PAGE_STRINGS[locale];
const alternates = {
  en: `projects/${slug}`,
  ar: `ar/مشاريع/${slug}`,
  es: `es/proyectos/${slug}`,
  fr: `fr/projets/${slug}`,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: title,
  description,
  learningResourceType: 'Project',
  educationalLevel: 'Beginner',
  isAccessibleForFree: true,
  inLanguage: locale,
  url: String(new URL(`${base}es/proyectos/${slug}`, Astro.site)),
  isPartOf: {
    '@type': 'Course',
    name: 'PyDA Course',
    description: ps.courseDescription,
  },
};
---

<Base title={`${title} — PyDA Course`} description={description} lang={locale} dir={dir} alternates={alternates} jsonLd={jsonLd}>
  <nav class="crumb container">
    <a href={projectsHref(locale, base)}>{title}</a> <span>/</span> <span class="crumb__here">{title}</span>
  </nav>

  <div class="container">
    <ProjectArt slug={slug} class="hero-art" />
  </div>

  <article class="container lesson-content">
    <h1 class="project-title">{title}</h1>
    <Content />
  </article>
</Base>

<script>
  import {viewProject} from '../../../lib/gameState.ts';
  const slug = location.pathname.split('/').filter(Boolean).pop() ?? '';
  if (slug) viewProject(slug);
</script>


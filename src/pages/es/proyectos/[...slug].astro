---
// ES project detail — thin wrapper over the shared ProjectDetail component,
// which serves the markdown, step-clearing and mark-done gamification.
import {getCollection} from 'astro:content';
import ProjectDetail from '../../../components/projects/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.slug.split('/')[0] === 'es')
    .map((entry) => {
      const slug = entry.slug.slice('es'.length + 1);
      return {params: {slug}, props: {entry}};
    });
}

const {entry} = Astro.props;
---

<ProjectDetail entry={entry} locale="es" />
---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Mi Progreso — PyDA Course" lang="es" dir="ltr">
  <section class="hero">
    <div class="container head">
      <h1>Sigue tu progreso</h1>
      <p>Cada lección ilumina una estación. XP, rachas e insignias te acompañan.</p>
      <a class="btn btn-primary" href={`${base}progress`} style="margin-top:1rem">Abrir progreso →</a>
    </div>
  </section>
</Base>
